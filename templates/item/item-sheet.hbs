                        {{localize 'ALTERNITY.AchievementBenefit.CostIsDoubleFlaw'}}
                    </label>
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.onePerLevel" data-dtype="Boolean" {{#if system.onePerLevel}}checked{{/if}}/>
                        {{localize 'ALTERNITY.AchievementBenefit.OnePerLevel'}}
                    </label>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.AchievementBenefit.Effect'}}</h3>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.AchievementBenefit.EffectTarget'}}</label>
                        <select name="system.effectTarget">
                            <option value="None" {{#if (eq system.effectTarget 'None')}}selected{{/if}}>&mdash;</option>
                            <option value="ActionCheckStep" {{#if (eq system.effectTarget 'ActionCheckStep')}}selected{{/if}}>{{localize 'ALTERNITY.AchievementBenefit.TargetActionStep'}}</option>
                            <option value="ActionCheckScore" {{#if (eq system.effectTarget 'ActionCheckScore')}}selected{{/if}}>{{localize 'ALTERNITY.AchievementBenefit.TargetActionScore'}}</option>
                            <option value="ActionsPerRound" {{#if (eq system.effectTarget 'ActionsPerRound')}}selected{{/if}}>{{localize 'ALTERNITY.AchievementBenefit.TargetActionsPerRound'}}</option>
                            <option value="AbilityScore" {{#if (eq system.effectTarget 'AbilityScore')}}selected{{/if}}>{{localize 'ALTERNITY.AchievementBenefit.TargetAbility'}}</option>
                            <option value="StunRating" {{#if (eq system.effectTarget 'StunRating')}}selected{{/if}}>{{localize 'ALTERNITY.AchievementBenefit.TargetStun'}}</option>
                            <option value="WoundRating" {{#if (eq system.effectTarget 'WoundRating')}}selected{{/if}}>{{localize 'ALTERNITY.AchievementBenefit.TargetWound'}}</option>
                            <option value="MortalRating" {{#if (eq system.effectTarget 'MortalRating')}}selected{{/if}}>{{localize 'ALTERNITY.AchievementBenefit.TargetMortal'}}</option>
                            <option value="FatigueRating" {{#if (eq system.effectTarget 'FatigueRating')}}selected{{/if}}>{{localize 'ALTERNITY.AchievementBenefit.TargetFatigue'}}</option>
                            <option value="PsionicEnergy" {{#if (eq system.effectTarget 'PsionicEnergy')}}selected{{/if}}>{{localize 'ALTERNITY.AchievementBenefit.TargetPsionicEnergy'}}</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.AchievementBenefit.EffectAbility'}}</label>
                        <select name="system.effectAbility">
                            <option value="None" {{#if (eq system.effectAbility 'None')}}selected{{/if}}>&mdash;</option>
                            <option value="STR" {{#if (eq system.effectAbility 'STR')}}selected{{/if}}>STR</option>
                            <option value="DEX" {{#if (eq system.effectAbility 'DEX')}}selected{{/if}}>DEX</option>
                            <option value="CON" {{#if (eq system.effectAbility 'CON')}}selected{{/if}}>CON</option>
                            <option value="INT" {{#if (eq system.effectAbility 'INT')}}selected{{/if}}>INT</option>
                            <option value="WIL" {{#if (eq system.effectAbility 'WIL')}}selected{{/if}}>WIL</option>
                            <option value="PER" {{#if (eq system.effectAbility 'PER')}}selected{{/if}}>PER</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.AchievementBenefit.EffectValue'}}</label>
                        <input type="number" name="system.effectValue" value="{{system.effectValue}}" data-dtype="Number"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.AchievementBenefit.Prerequisites'}}</label>
                    <input type="text" name="system.prerequisites" value="{{system.prerequisites}}" data-dtype="String" placeholder="Not above the species maximum"/>
                </div>

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.AchievementBenefit.Cost'}}:</strong> {{system.costDisplay}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.AchievementBenefit.Requires'}}:</strong> {{system.levelDisplay}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.AchievementBenefit.Purchases'}}:</strong> {{system.purchasesDisplay}}</span>
                    {{#if system.hasEffect}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.AchievementBenefit.Effect'}}:</strong> {{system.effectDisplay}}{{#if system.isPurchased}} ({{localize 'ALTERNITY.AchievementBenefit.TotalApplied'}}: {{system.totalEffectValue}}){{/if}}</span>
                    {{/if}}
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.AchievementBenefit.Status'}}:</strong> {{system.statusLabel}}</span>
                </div>
            {{/if}}

            {{!-- Shared inventory fields, only for the types whose schema defines them --}}
            {{#if (or (eq document.type 'computer') (eq document.type 'personalEquipment'))}}
            <div class="form-group">
                <label>{{localize 'ALTERNITY.Mass'}}</label>
                <input type="number" name="system.mass" value="{{system.mass}}" data-dtype="Number" min="0" step="0.1"/>
            </div>
            {{/if}}

            {{#if (or (or (eq document.type 'weapon') (eq document.type 'armor')) (eq document.type 'personalEquipment'))}}
            <div class="form-group">
                <label class="alt-checkbox-inline">
                    <input type="checkbox" name="system.isEquipped" data-dtype="Boolean" {{#if system.isEquipped}}checked{{/if}}/>
                    {{localize 'ALTERNITY.Equipped'}}
                </label>
            </div>
            {{/if}}
        </div>
    </section>
</div>
