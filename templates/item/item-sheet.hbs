{{!--
    Shared Details/Description sheet for every Alternity item type.

    NOTE: this template must NOT declare its own <form>. AlternityItemSheet sets
    `tag: "form"` in DEFAULT_OPTIONS, so ApplicationV2 already renders the <form>
    root that Foundry's form controller binds to. Declaring one here produced a
    nested form (it survives parsing because HandlebarsApplicationMixin builds part
    HTML in a detached <div>), which made every input belong to the *inner* form —
    the one with no submit handler. Enter then triggered the browser's native
    submission and navigated to /game?name=…

    What made that reachable at all: per the HTML spec, a form with no submit button
    only submits implicitly when it has *exactly one* field that blocks implicit
    submission (text/number-style inputs; select and textarea don't count). Back when
    the Details tab rendered empty, Name was the only such field. That is also why the
    actor sheets never showed this despite having the same nested <form> — they have
    dozens of inputs, so the browser refuses to submit implicitly.

    Controls here are <a>, never <button>, as defensive habit (the Fallout system uses
    the same convention): a <button> without an explicit type="button" is a submit
    button, and a submit button bypasses the one-field rule entirely.
--}}
<div class="{{alt}}-sheet {{alt}}-item-sheet" autocomplete="off">
    {{!--
        The header binds to `source` and `document`, which DocumentSheetV2._prepareContext
        always supplies, rather than to a context key this sheet class adds itself. `source`
        is the raw document._source, which is what a form input should round-trip.
    --}}
    <header class="sheet-header">
        <img class="profile-img" src="{{source.img}}" data-edit="img" title="{{source.name}}"/>
        <div class="header-fields">
            <h1 class="charname">
                <input name="name" type="text" value="{{source.name}}" placeholder="{{localize 'Name'}}"/>
            </h1>
            <div class="grid grid-2col">
                <div class="resource">
                    <label>{{localize 'ALTERNITY.ItemType'}}</label>
                    <span>{{#if typeLabel}}{{typeLabel}}{{else}}{{document.type}}{{/if}}</span>
                </div>
                {{#if (or (eq document.type 'weapon') (eq document.type 'personalEquipment'))}}
                <div class="resource">
                    <label>{{localize 'ALTERNITY.Quantity'}}</label>
                    <input type="number" name="system.quantity" value="{{system.quantity}}" data-dtype="Number" min="0"/>
                </div>
                {{/if}}
            </div>
        </div>
    </header>

    {{!-- Item Sheet Navigation --}}
    <nav class="sheet-tabs tabs">
        <a class="item {{#if (eq activeTab 'description')}}active{{/if}}" data-action="switchTab" data-tab="description">{{localize 'ALTERNITY.Description'}}</a>
        <a class="item {{#if (eq activeTab 'details')}}active{{/if}}" data-action="switchTab" data-tab="details">{{localize 'ALTERNITY.Details'}}</a>
    </nav>

    {{!-- Item Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        <div class="tab {{#if (eq activeTab 'description')}}active{{/if}}" data-tab="description">
            {{!-- {{formInput}} renders the HTMLField as a <prose-mirror> element. The old
                  {{editor … button=true}} helper injected an untyped <button>, which acted
                  as a submit button and triggered the Enter-key navigation bug. --}}
            {{#if systemFields.description}}
                {{formInput systemFields.description value=system.description name="system.description"}}
            {{else}}
                <textarea name="system.description" rows="12">{{system.description}}</textarea>
            {{/if}}
        </div>

        {{!-- Details Tab --}}
        <div class="tab details {{#if (eq activeTab 'details')}}active{{/if}}" data-tab="details">

            {{#if (eq document.type 'weapon')}}
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.WeaponType'}}</label>
                    <select name="system.weaponType">
                        {{selectOptions config.weaponTypes selected=system.weaponType}}
                    </select>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.DamageFormula'}}</label>
                        <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" data-dtype="String"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weapon.DamageBonus'}}</label>
                        <input type="number" name="system.damageBonus" value="{{system.damageBonus}}" data-dtype="Number"/>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.DamageType'}}</label>
                        <select name="system.damageType">
                            {{selectOptions config.damageTypes selected=system.damageType}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.DamageCategory'}}</label>
                        {{!-- Inline options on purpose: these mirror the schema's own
                              `choices` and need no context.config key, so the sheet still
                              renders if _prepareContext ever fails to supply one. --}}
                        <select name="system.damageCategory">
                            <option value="stun" {{#if (eq system.damageCategory 'stun')}}selected{{/if}}>{{localize 'ALTERNITY.Stun'}}</option>
                            <option value="wound" {{#if (eq system.damageCategory 'wound')}}selected{{/if}}>{{localize 'ALTERNITY.Wound'}}</option>
                            <option value="mortal" {{#if (eq system.damageCategory 'mortal')}}selected{{/if}}>{{localize 'ALTERNITY.Mortal'}}</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weapon.AttackAbility'}}</label>
                        <select name="system.attackAbility">
                            <option value="str" {{#if (eq system.attackAbility 'str')}}selected{{/if}}>STR</option>
                            <option value="dex" {{#if (eq system.attackAbility 'dex')}}selected{{/if}}>DEX</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weapon.AttackBonus'}}</label>
                        <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" data-dtype="Number"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.RequiredSkill'}}</label>
                    <select name="system.requiredSkill">
                        <option value="">&mdash;</option>
                        {{selectOptions config.skills selected=system.requiredSkill}}
                    </select>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Short'}}</label>
                        <input type="number" name="system.range.short" value="{{system.range.short}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Medium'}}</label>
                        <input type="number" name="system.range.medium" value="{{system.range.medium}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Long'}}</label>
                        <input type="number" name="system.range.long" value="{{system.range.long}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.TechPointCost'}}</label>
                        <input type="number" name="system.techPointCost" value="{{system.techPointCost}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weight'}}</label>
                        <input type="number" name="system.weight" value="{{system.weight}}" data-dtype="Number" min="0" step="0.1"/>
                    </div>
                </div>

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Weapon.TotalAttackBonus'}}:</strong> {{system.totalAttackBonus}} ({{system.abilityModLabel}} {{localize 'ALTERNITY.Weapon.AttackAbility'}})</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.DamageFormula'}}:</strong> {{system.fullDamageFormula}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Range'}}:</strong> {{system.rangeDisplay}}</span>
                    {{#if system.usesTechPoints}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.TechPointCost'}}:</strong> {{system.techCostDisplay}}</span>
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq document.type 'armor')}}
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Armor.Type'}}</label>
                        <select name="system.armorType">
                            {{selectOptions config.armorTypes selected=system.armorType}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Armor.DefenseBonus'}}</label>
                        <input type="number" name="system.armorBonus" value="{{system.armorBonus}}" data-dtype="Number" min="0" max="15"/>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.SpeedPenalty'}}</label>
                        <input type="number" name="system.speedPenalty" value="{{system.speedPenalty}}" data-dtype="Number" min="0" max="30"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Armor.SkillPenalty'}}</label>
                        <input type="number" name="system.skillPenalty" value="{{system.skillPenalty}}" data-dtype="Number" min="0" max="10"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Armor.DamageResistance'}}</label>
                    <input type="number" name="system.damageResistance" value="{{system.damageResistance}}" data-dtype="Number" min="0"/>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Armor.ResistedTypes'}}</label>
                    <div class="alt-checkbox-row">
                        {{#each config.damageTypes as |label key|}}
                        <label class="alt-checkbox-inline">
                            <input type="checkbox" name="system.resistedTypes" value="{{key}}" {{#if (includes ../system.resistedTypes key)}}checked{{/if}}/>
                            {{key}}
                        </label>
                        {{/each}}
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.TechPointCost'}}</label>
                        <input type="number" name="system.techPointCost" value="{{system.techPointCost}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weight'}}</label>
                        <input type="number" name="system.weight" value="{{system.weight}}" data-dtype="Number" min="0" step="0.1"/>
                    </div>
                </div>

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Armor.DefenseBonus'}}:</strong> {{system.defenseBonusLabel}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.SpeedPenalty'}}:</strong> {{system.speedPenaltyLabel}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Armor.SkillPenalty'}}:</strong> {{system.skillPenaltyLabel}}</span>
                    {{#if system.hasResistance}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Armor.DamageResistance'}}:</strong> {{system.resistanceLabel}}</span>
                    {{/if}}
                    {{#if system.usesTechPoints}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.TechPointCost'}}:</strong> {{system.techCostDisplay}}</span>
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq document.type 'computer')}}
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Computer.Processor'}}</label>
                    <input type="text" name="system.processorQuality" value="{{system.processorQuality}}" data-dtype="String"/>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Computer.Memory'}}</label>
                        <input type="number" name="system.activeMemory" value="{{system.activeMemory}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Computer.Storage'}}</label>
                        <input type="number" name="system.activeStorage" value="{{system.activeStorage}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Computer.Programs'}}</label>
                    {{#if systemFields.programs}}
                        {{formInput systemFields.programs value=system.programs name="system.programs"}}
                    {{else}}
                        <textarea name="system.programs" rows="10">{{system.programs}}</textarea>
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq document.type 'skill')}}
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Skill.SkillId'}}</label>
                        <select name="system.skillId">
                            <option value="">&mdash;</option>
                            {{selectOptions config.skills selected=system.skillId}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Skill.LinkedAbility'}}</label>
                        <select name="system.linkedAbility">
                            {{selectOptions config.abilities selected=system.linkedAbility}}
                        </select>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Skill.Rank'}}</label>
                        <input type="number" name="system.rank" value="{{system.rank}}" data-dtype="Number" min="0" max="10"/>
                    </div>
                    <div class="form-group">
                        <label class="alt-checkbox-inline">
                            <input type="checkbox" name="system.isBackground" data-dtype="Boolean" {{#if system.isBackground}}checked{{/if}}/>
                            {{localize 'ALTERNITY.Skill.IsBackground'}}
                        </label>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Skill.Specialisation'}}</label>
                        <input type="text" name="system.specialisation" value="{{system.specialisation}}" data-dtype="String"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Skill.SpecialisationBonus'}}</label>
                        <input type="number" name="system.specialisationBonus" value="{{system.specialisationBonus}}" data-dtype="Number" min="0" max="5"/>
                    </div>
                </div>

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Skill.EffectiveRank'}}:</strong> {{system.rankDisplay}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Skill.TargetNumber'}}:</strong> {{system.dcDisplay}}</span>
                    {{#if system.specialisation}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Skill.TargetNumberWithSpec'}}:</strong> DC {{system.targetNumberWithSpec}}</span>
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq document.type 'effect')}}
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Effect.Category'}}</label>
                        <select name="system.effectCategory">
                            {{selectOptions config.effectCategories selected=system.effectCategory}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Effect.TargetScope'}}</label>
                        <select name="system.targetScope">
                            {{selectOptions config.effectTargetScopes selected=system.targetScope}}
                        </select>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Effect.Activation'}}</label>
                        <select name="system.activation">
                            {{selectOptions config.effectActivations selected=system.activation}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="alt-checkbox-inline">
                            <input type="checkbox" name="system.isReusable" data-dtype="Boolean" {{#if system.isReusable}}checked{{/if}}/>
                            {{localize 'ALTERNITY.Effect.IsReusable'}}
                        </label>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.TechPoints'}}</label>
                        <input type="number" name="system.techPointCost" value="{{system.techPointCost}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PsiPoints'}}</label>
                        <input type="number" name="system.psiPointCost" value="{{system.psiPointCost}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Effect.TriggerContext'}}</label>
                    <input type="text" name="system.triggerContext" value="{{system.triggerContext}}" data-dtype="String" placeholder="Combat, Stealth, Any…"/>
                </div>

                <div class="alt-item-array-section">
                    <h3>
                        {{localize 'ALTERNITY.Effect.Entries'}}
                        <a class="alt-item-array-add" data-action="addArrayRow" data-array="effects" data-tooltip="{{localize 'ALTERNITY.AddRow'}}"><i class="fas fa-plus"></i></a>
                    </h3>
                    <div class="alt-item-array-table">
                        {{#each system.effects as |row idx|}}
                        <div class="alt-item-array-row">
                            <select name="system.effects.{{idx}}.effectType">
                                {{#each ../config.effectEntryTypes as |choice|}}
                                <option value="{{choice}}" {{#if (eq row.effectType choice)}}selected{{/if}}>{{choice}}</option>
                                {{/each}}
                            </select>
                            <input type="number" name="system.effects.{{idx}}.value" value="{{row.value}}" data-dtype="Number" title="{{localize 'ALTERNITY.Effect.Value'}}"/>
                            <select name="system.effects.{{idx}}.damageType" title="{{localize 'ALTERNITY.DamageType'}}">
                                {{selectOptions ../config.damageTypes selected=row.damageType}}
                            </select>
                            <input type="text" name="system.effects.{{idx}}.stat" value="{{row.stat}}" data-dtype="String" placeholder="{{localize 'ALTERNITY.Effect.Stat'}}"/>
                            <select name="system.effects.{{idx}}.duration">
                                {{#each ../config.effectDurations as |choice|}}
                                <option value="{{choice}}" {{#if (eq row.duration choice)}}selected{{/if}}>{{choice}}</option>
                                {{/each}}
                            </select>
                            <input type="text" name="system.effects.{{idx}}.notes" value="{{row.notes}}" data-dtype="String" placeholder="{{localize 'ALTERNITY.Effect.Notes'}}"/>
                            <a class="alt-item-array-delete" data-action="deleteArrayRow" data-array="effects" data-index="{{idx}}" data-tooltip="{{localize 'ALTERNITY.DeleteRow'}}"><i class="fas fa-times"></i></a>
                        </div>
                        {{/each}}
                    </div>
                </div>

                <div class="alt-item-array-section">
                    <h3>
                        {{localize 'ALTERNITY.Effect.RequiredChecks'}}
                        <a class="alt-item-array-add" data-action="addArrayRow" data-array="requiredChecks" data-tooltip="{{localize 'ALTERNITY.AddRow'}}"><i class="fas fa-plus"></i></a>
                    </h3>
                    <div class="alt-item-array-table">
                        {{#each system.requiredChecks as |row idx|}}
                        <div class="alt-item-array-row alt-item-array-row-wrap">
                            <select name="system.requiredChecks.{{idx}}.checkType">
                                {{#each ../config.checkTypes as |choice|}}
                                <option value="{{choice}}" {{#if (eq row.checkType choice)}}selected{{/if}}>{{choice}}</option>
                                {{/each}}
                            </select>
                            <input type="text" name="system.requiredChecks.{{idx}}.failMessage" value="{{row.failMessage}}" data-dtype="String" placeholder="{{localize 'ALTERNITY.Effect.FailMessage'}}"/>
                            <textarea name="system.requiredChecks.{{idx}}.params" rows="1" placeholder="{{localize 'ALTERNITY.Effect.Params'}}">{{row.paramsJson}}</textarea>
                            <a class="alt-item-array-delete" data-action="deleteArrayRow" data-array="requiredChecks" data-index="{{idx}}" data-tooltip="{{localize 'ALTERNITY.DeleteRow'}}"><i class="fas fa-times"></i></a>
                        </div>
                        {{/each}}
                    </div>
                </div>

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Effect.CostDisplay'}}:</strong> {{system.costDisplay}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Effect.Activation'}}:</strong> {{system.activationLabel}}</span>
                </div>
            {{/if}}

            {{#if (eq document.type 'perkFlaw')}}
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PerkFlaw.Category'}}</label>
                        <select name="system.category">
                            {{selectOptions config.perkFlawCategories selected=system.category}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PerkFlaw.LinkedAbility'}}</label>
                        <select name="system.linkedAbility">
                            {{selectOptions config.perkFlawAbilities selected=system.linkedAbility}}
                        </select>
                    </div>
                </div>

                {{#if (eq system.category 'Perk')}}
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PerkFlaw.ActivationType'}}</label>
                        <select name="system.activationType">
                            {{selectOptions config.perkFlawActivationTypes selected=system.activationType}}
                        </select>
                    </div>
                {{/if}}

                <div class="form-group">
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.isTiered" data-dtype="Boolean" {{#if system.isTiered}}checked{{/if}}/>
                        {{localize 'ALTERNITY.PerkFlaw.IsTiered'}}
                    </label>
                </div>

                {{#if system.isTiered}}
                    <div class="grid grid-3col">
                        <div class="form-group">
                            <label>{{localize 'ALTERNITY.PerkFlaw.TierCost'}} 1</label>
                            <input type="number" name="system.tierCosts.0" value="{{lookup system.tierCosts 0}}" data-dtype="Number" min="0"/>
                        </div>
                        <div class="form-group">
                            <label>{{localize 'ALTERNITY.PerkFlaw.TierCost'}} 2</label>
                            <input type="number" name="system.tierCosts.1" value="{{lookup system.tierCosts 1}}" data-dtype="Number" min="0"/>
                        </div>
                        <div class="form-group">
                            <label>{{localize 'ALTERNITY.PerkFlaw.TierCost'}} 3</label>
                            <input type="number" name="system.tierCosts.2" value="{{lookup system.tierCosts 2}}" data-dtype="Number" min="0"/>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PerkFlaw.CurrentTier'}}</label>
                        <input type="number" name="system.currentTier" value="{{system.currentTier}}" data-dtype="Number" min="0" max="3"/>
                    </div>
                {{else}}
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PerkFlaw.Cost'}}</label>
                        <input type="number" name="system.cost" value="{{system.cost}}" data-dtype="Number" min="0"/>
                    </div>
                {{/if}}

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.PerkFlaw.Cost'}}:</strong> {{system.costLabel}}</span>
                    {{#if (eq system.category 'Perk')}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.PerkFlaw.ActivationType'}}:</strong> {{system.activationLabel}}</span>
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq document.type 'personalEquipment')}}
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PersonalEquipment.Category'}}</label>
                        <select name="system.category">
                            {{selectOptions config.personalEquipmentCategories selected=system.category}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PersonalEquipment.ProgressLevel'}}</label>
                        <input type="number" name="system.progressLevel" value="{{system.progressLevel}}" data-dtype="Number" min="0" max="8"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.PersonalEquipment.Cost'}}</label>
                    <input type="number" name="system.cost" value="{{system.cost}}" data-dtype="Number" min="0"/>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PersonalEquipment.BonusSkill'}}</label>
                        <input type="text" name="system.bonusSkill" value="{{system.bonusSkill}}" data-dtype="String"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PersonalEquipment.BonusValue'}}</label>
                        <input type="number" name="system.bonusValue" value="{{system.bonusValue}}" data-dtype="Number"/>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PersonalEquipment.MaxCharges'}}</label>
                        <input type="number" name="system.maxCharges" value="{{system.maxCharges}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.PersonalEquipment.CurrentCharges'}}</label>
                        <input type="number" name="system.currentCharges" value="{{system.currentCharges}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.PersonalEquipment.PowerNotes'}}</label>
                    <input type="text" name="system.powerNotes" value="{{system.powerNotes}}" data-dtype="String"/>
                </div>

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.PersonalEquipment.ProgressLevel'}}:</strong> {{system.plLabel}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.PersonalEquipment.Cost'}}:</strong> {{system.costDisplay}}</span>
                    {{#if system.hasBonus}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Bonus'}}:</strong> {{system.bonusDisplay}}</span>
                    {{/if}}
                    {{#if system.isLimitedUse}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.PersonalEquipment.MaxCharges'}}:</strong> {{system.chargesDisplay}}</span>
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq document.type 'cybertech')}}
                {{!-- Selects here use inline <option> markup rather than {{selectOptions config.x}}:
                      they mirror CybertechData's own schema choices, and an undefined config key
                      makes selectOptions throw, which aborts the render of this whole shared sheet. --}}
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.Category'}}</label>
                        <select name="system.category">
                            <option value="Weapon" {{#if (eq system.category 'Weapon')}}selected{{/if}}>{{localize 'ALTERNITY.Cybertech.CategoryWeapon'}}</option>
                            <option value="Protection" {{#if (eq system.category 'Protection')}}selected{{/if}}>{{localize 'ALTERNITY.Cybertech.CategoryProtection'}}</option>
                            <option value="Enhancement" {{#if (eq system.category 'Enhancement')}}selected{{/if}}>{{localize 'ALTERNITY.Cybertech.CategoryEnhancement'}}</option>
                            <option value="Sensory" {{#if (eq system.category 'Sensory')}}selected{{/if}}>{{localize 'ALTERNITY.Cybertech.CategorySensory'}}</option>
                            <option value="Interface" {{#if (eq system.category 'Interface')}}selected{{/if}}>{{localize 'ALTERNITY.Cybertech.CategoryInterface'}}</option>
                            <option value="Utility" {{#if (eq system.category 'Utility')}}selected{{/if}}>{{localize 'ALTERNITY.Cybertech.CategoryUtility'}}</option>
                            <option value="Cosmetic" {{#if (eq system.category 'Cosmetic')}}selected{{/if}}>{{localize 'ALTERNITY.Cybertech.CategoryCosmetic'}}</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.Quality'}}</label>
                        <select name="system.quality">
                            <option value="Ordinary" {{#if (eq system.quality 'Ordinary')}}selected{{/if}}>{{localize 'ALTERNITY.Quality.Ordinary'}}</option>
                            <option value="Good" {{#if (eq system.quality 'Good')}}selected{{/if}}>{{localize 'ALTERNITY.Quality.Good'}}</option>
                            <option value="Amazing" {{#if (eq system.quality 'Amazing')}}selected{{/if}}>{{localize 'ALTERNITY.Quality.Amazing'}}</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.ProgressLevel'}}</label>
                        <input type="number" name="system.progressLevel" value="{{system.progressLevel}}" data-dtype="Number" min="0" max="9"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.Size'}}</label>
                        <input type="number" name="system.size" value="{{system.size}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.Cost'}}</label>
                        <input type="number" name="system.cost" value="{{system.cost}}" data-dtype="Number" min="0"/>
                    </div>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.Cybertech.Requirements'}}</h3>
                <div class="alt-checkbox-row">
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.requiresNanocomputer" data-dtype="Boolean" {{#if system.requiresNanocomputer}}checked{{/if}}/>
                        {{localize 'ALTERNITY.Cybertech.RequiresNanocomputer'}}
                    </label>
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.requiresExoskeleton" data-dtype="Boolean" {{#if system.requiresExoskeleton}}checked{{/if}}/>
                        {{localize 'ALTERNITY.Cybertech.RequiresExoskeleton'}}
                    </label>
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.requiresCyberlimb" data-dtype="Boolean" {{#if system.requiresCyberlimb}}checked{{/if}}/>
                        {{localize 'ALTERNITY.Cybertech.RequiresCyberlimb'}}
                    </label>
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.requiresSkillPoints" data-dtype="Boolean" {{#if system.requiresSkillPoints}}checked{{/if}}/>
                        {{localize 'ALTERNITY.Cybertech.RequiresSkillPoints'}}
                    </label>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.Cybertech.Benefits'}}</h3>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.AbilityModifier'}}</label>
                        <select name="system.abilityModifier.ability">
                            <option value="None" {{#if (eq system.abilityModifier.ability 'None')}}selected{{/if}}>&mdash;</option>
                            <option value="STR" {{#if (eq system.abilityModifier.ability 'STR')}}selected{{/if}}>STR</option>
                            <option value="DEX" {{#if (eq system.abilityModifier.ability 'DEX')}}selected{{/if}}>DEX</option>
                            <option value="CON" {{#if (eq system.abilityModifier.ability 'CON')}}selected{{/if}}>CON</option>
                            <option value="INT" {{#if (eq system.abilityModifier.ability 'INT')}}selected{{/if}}>INT</option>
                            <option value="WIL" {{#if (eq system.abilityModifier.ability 'WIL')}}selected{{/if}}>WIL</option>
                            <option value="PER" {{#if (eq system.abilityModifier.ability 'PER')}}selected{{/if}}>PER</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.AbilityModifierValue'}}</label>
                        <input type="number" name="system.abilityModifier.value" value="{{system.abilityModifier.value}}" data-dtype="Number"/>
                    </div>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.BonusStun'}}</label>
                        <input type="number" name="system.durabilityBonus.stun" value="{{system.durabilityBonus.stun}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.BonusWound'}}</label>
                        <input type="number" name="system.durabilityBonus.wound" value="{{system.durabilityBonus.wound}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.BonusMortal'}}</label>
                        <input type="number" name="system.durabilityBonus.mortal" value="{{system.durabilityBonus.mortal}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.ArmorLI'}}</label>
                        <input type="text" name="system.armorProtection.li" value="{{system.armorProtection.li}}" data-dtype="String" placeholder="d4"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.ArmorHI'}}</label>
                        <input type="text" name="system.armorProtection.hi" value="{{system.armorProtection.hi}}" data-dtype="String" placeholder="d4"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.ArmorEN'}}</label>
                        <input type="text" name="system.armorProtection.en" value="{{system.armorProtection.en}}" data-dtype="String" placeholder="d4-1"/>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.ActionCheckModifier'}}</label>
                        <input type="number" name="system.actionCheckModifier" value="{{system.actionCheckModifier}}" data-dtype="Number" min="-5" max="5"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.DamageFormula'}}</label>
                        <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" data-dtype="String" placeholder="d4+2w/d6+2w/d4m"/>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.ActivationCost'}}</label>
                        <input type="text" name="system.activationCost" value="{{system.activationCost}}" data-dtype="String" placeholder="1 fatigue per use"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Mass'}}</label>
                        <input type="number" name="system.mass" value="{{system.mass}}" data-dtype="Number" min="0" step="0.1"/>
                    </div>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.Cybertech.Status'}}</h3>
                <div class="alt-checkbox-row">
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.isInstalled" data-dtype="Boolean" {{#if system.isInstalled}}checked{{/if}}/>
                        {{localize 'ALTERNITY.Cybertech.IsInstalled'}}
                    </label>
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.isDamaged" data-dtype="Boolean" {{#if system.isDamaged}}checked{{/if}}/>
                        {{localize 'ALTERNITY.Cybertech.IsDamaged'}}
                    </label>
                </div>

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.Quality'}}:</strong> {{system.quality}} &mdash; {{system.plLabel}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.Size'}}:</strong> {{system.sizeDisplay}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.Cost'}}:</strong> {{system.costDisplay}}</span>
                    {{#if system.hasRequirements}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.Requirements'}}:</strong> {{system.requirementsDisplay}}</span>
                    {{/if}}
                    {{#if system.hasAbilityModifier}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.AbilityModifier'}}:</strong> {{system.abilityModifierDisplay}}</span>
                    {{/if}}
                    {{#if system.hasDurabilityBonus}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.Durability'}}:</strong> {{system.durabilityDisplay}}</span>
                    {{/if}}
                    {{#if system.hasArmorProtection}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.Armor'}}:</strong> {{system.armorDisplay}}</span>
                    {{/if}}
                    {{#if system.hasActionCheckModifier}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.ActionCheckModifier'}}:</strong> {{system.actionCheckDisplay}}</span>
                    {{/if}}
                    {{#if system.hasDamage}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.DamageFormula'}}:</strong> {{system.damageFormula}}</span>
                    {{/if}}
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.Status'}}:</strong> {{system.statusLabel}}</span>
                </div>
            {{/if}}

            {{!-- Shared inventory fields, only for the types whose schema defines them --}}
            {{#if (or (eq document.type 'computer') (eq document.type 'personalEquipment'))}}
            <div class="form-group">
                <label>{{localize 'ALTERNITY.Mass'}}</label>
                <input type="number" name="system.mass" value="{{system.mass}}" data-dtype="Number" min="0" step="0.1"/>
            </div>
            {{/if}}

            {{#if (or (or (eq document.type 'weapon') (eq document.type 'armor')) (eq document.type 'personalEquipment'))}}
            <div class="form-group">
                <label class="alt-checkbox-inline">
                    <input type="checkbox" name="system.isEquipped" data-dtype="Boolean" {{#if system.isEquipped}}checked{{/if}}/>
                    {{localize 'ALTERNITY.Equipped'}}
                </label>
            </div>
            {{/if}}
        </div>
    </section>
</div>
