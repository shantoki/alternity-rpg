{{!--
    Shared Details/Description sheet for every Alternity item type.

    NOTE: this template must NOT declare its own <form>. AlternityItemSheet sets
    `tag: "form"` in DEFAULT_OPTIONS, so ApplicationV2 already renders the <form>
    root that Foundry's form controller binds to. Declaring one here produced a
    nested form (it survives parsing because HandlebarsApplicationMixin builds part
    HTML in a detached <div>), which made every input belong to the *inner* form —
    the one with no submit handler. Enter then triggered the browser's native
    submission and navigated to /game?name=…

    What made that reachable at all: per the HTML spec, a form with no submit button
    only submits implicitly when it has *exactly one* field that blocks implicit
    submission (text/number-style inputs; select and textarea don't count). Back when
    the Details tab rendered empty, Name was the only such field. That is also why the
    actor sheets never showed this despite having the same nested <form> — they have
    dozens of inputs, so the browser refuses to submit implicitly.

    Controls here are <a>, never <button>, as defensive habit (the Fallout system uses
    the same convention): a <button> without an explicit type="button" is a submit
    button, and a submit button bypasses the one-field rule entirely.
--}}
<div class="{{alt}}-sheet {{alt}}-item-sheet" autocomplete="off">
    {{!--
        The header binds to `source` and `document`, which DocumentSheetV2._prepareContext
        always supplies, rather than to a context key this sheet class adds itself. `source`
        is the raw document._source, which is what a form input should round-trip.
    --}}
    <header class="sheet-header">
        <img class="profile-img" src="{{source.img}}" data-edit="img" title="{{source.name}}"/>
        <div class="header-fields">
            <h1 class="charname">
                <input name="name" type="text" value="{{source.name}}" placeholder="{{localize 'Name'}}"/>
            </h1>
            <div class="grid grid-2col">
                <div class="resource">
                    <label>{{localize 'ALTERNITY.ItemType'}}</label>
                    <span>{{#if typeLabel}}{{typeLabel}}{{else}}{{document.type}}{{/if}}</span>
                </div>
                {{#if (or (eq document.type 'weapon') (eq document.type 'personalEquipment'))}}
                <div class="resource">
                    <label>{{localize 'ALTERNITY.Quantity'}}</label>
                    <input type="number" name="system.quantity" value="{{system.quantity}}" data-dtype="Number" min="0"/>
                </div>
                {{/if}}
            </div>
        </div>
    </header>

    {{!-- Item Sheet Navigation --}}
    <nav class="sheet-tabs tabs">
        <a class="item {{#if (eq activeTab 'description')}}active{{/if}}" data-action="switchTab" data-tab="description">{{localize 'ALTERNITY.Description'}}</a>
        <a class="item {{#if (eq activeTab 'details')}}active{{/if}}" data-action="switchTab" data-tab="details">{{localize 'ALTERNITY.Details'}}</a>
    </nav>

    {{!-- Item Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        <div class="tab {{#if (eq activeTab 'description')}}active{{/if}}" data-tab="description">
            {{!-- {{formInput}} renders the HTMLField as a <prose-mirror> element. The old
                  {{editor … button=true}} helper injected an untyped <button>, which acted
                  as a submit button and triggered the Enter-key navigation bug. --}}
            {{#if systemFields.description}}
                {{formInput systemFields.description value=system.description name="system.description"}}
            {{else}}
                <textarea name="system.description" rows="12">{{system.description}}</textarea>
            {{/if}}
        </div>

        {{!-- Details Tab --}}
        <div class="tab details {{#if (eq activeTab 'details')}}active{{/if}}" data-tab="details">

            {{#if (eq document.type 'weapon')}}
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.WeaponType'}}</label>
                    <select name="system.weaponType">
                        {{selectOptions config.weaponTypes selected=system.weaponType}}
                    </select>
                </div>
                {{!-- Damage is a three-column run, applied by the degree the attack
                      check achieves (PHB Ch.11). Each code carries its own grade
                      letter — "d4+1s" is stun, "d6+2w" is wound — so one weapon's
                      three columns can land on three different tracks. --}}
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label title="{{localize 'ALTERNITY.Weapon.DamageRunHint'}}">{{localize 'ALTERNITY.DegreeOrdinary'}}</label>
                        <input type="text" name="system.damageOrdinary" value="{{system.damageOrdinary}}" data-dtype="String" placeholder="d4+1s"/>
                    </div>
                    <div class="form-group">
                        <label title="{{localize 'ALTERNITY.Weapon.DamageRunHint'}}">{{localize 'ALTERNITY.DegreeGood'}}</label>
                        <input type="text" name="system.damageGood" value="{{system.damageGood}}" data-dtype="String" placeholder="d4w"/>
                    </div>
                    <div class="form-group">
                        <label title="{{localize 'ALTERNITY.Weapon.DamageRunHint'}}">{{localize 'ALTERNITY.DegreeAmazing'}}</label>
                        <input type="text" name="system.damageAmazing" value="{{system.damageAmazing}}" data-dtype="String" placeholder="d6+2w"/>
                    </div>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.DamageType'}}</label>
                        <select name="system.damageType">
                            {{selectOptions config.damageTypes selected=system.damageType}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label title="{{localize 'ALTERNITY.Weapon.FirepowerHint'}}">{{localize 'ALTERNITY.Weapon.Firepower'}}</label>
                        <select name="system.firepower">
                            <option value="Marginal" {{#if (eq system.firepower 'Marginal')}}selected{{/if}}>Marginal</option>
                            <option value="Ordinary" {{#if (eq system.firepower 'Ordinary')}}selected{{/if}}>Ordinary</option>
                            <option value="Good" {{#if (eq system.firepower 'Good')}}selected{{/if}}>Good</option>
                            <option value="Amazing" {{#if (eq system.firepower 'Amazing')}}selected{{/if}}>Amazing</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weapon.DamageBonus'}}</label>
                        <input type="number" name="system.damageBonus" value="{{system.damageBonus}}" data-dtype="Number"/>
                    </div>
                </div>
                <div class="form-group">
                    <label title="{{localize 'ALTERNITY.DamageCategoryHint'}}">{{localize 'ALTERNITY.DamageCategory'}}</label>
                    {{!-- Only consulted for a damage code written without a grade
                          letter. Inline options on purpose: these mirror the schema's own
                          `choices` and need no context.config key, so the sheet still
                          renders if _prepareContext ever fails to supply one. --}}
                    <select name="system.damageCategory">
                        <option value="stun" {{#if (eq system.damageCategory 'stun')}}selected{{/if}}>{{localize 'ALTERNITY.Stun'}}</option>
                        <option value="wound" {{#if (eq system.damageCategory 'wound')}}selected{{/if}}>{{localize 'ALTERNITY.Wound'}}</option>
                        <option value="mortal" {{#if (eq system.damageCategory 'mortal')}}selected{{/if}}>{{localize 'ALTERNITY.Mortal'}}</option>
                    </select>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weapon.AttackAbility'}}</label>
                        <select name="system.attackAbility">
                            <option value="str" {{#if (eq system.attackAbility 'str')}}selected{{/if}}>STR</option>
                            <option value="dex" {{#if (eq system.attackAbility 'dex')}}selected{{/if}}>DEX</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weapon.AttackBonus'}}</label>
                        <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" data-dtype="Number"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.RequiredSkill'}}</label>
                    <select name="system.requiredSkill">
                        <option value="">&mdash;</option>
                        {{selectOptions config.skills selected=system.requiredSkill}}
                    </select>
                </div>
                {{!-- Which row of Table P22 this weapon reads for its range-band step
                      modifiers. A separate axis from Weapon Type: a rifle and a pistol
                      are both "Ranged" and degrade over distance quite differently. --}}
                <div class="form-group">
                    <label title="{{localize 'ALTERNITY.Weapon.RangeClassHint'}}">{{localize 'ALTERNITY.Weapon.RangeClass'}}</label>
                    <select name="system.rangeClass">
                        <option value="Melee" {{#if (eq system.rangeClass 'Melee')}}selected{{/if}}>{{localize 'ALTERNITY.Weapon.RangeClassMelee'}}</option>
                        <option value="Primitive" {{#if (eq system.rangeClass 'Primitive')}}selected{{/if}}>{{localize 'ALTERNITY.Weapon.RangeClassPrimitive'}}</option>
                        <option value="Pistol" {{#if (eq system.rangeClass 'Pistol')}}selected{{/if}}>{{localize 'ALTERNITY.Weapon.RangeClassPistol'}}</option>
                        <option value="Rifle" {{#if (eq system.rangeClass 'Rifle')}}selected{{/if}}>{{localize 'ALTERNITY.Weapon.RangeClassRifle'}}</option>
                        <option value="SMG" {{#if (eq system.rangeClass 'SMG')}}selected{{/if}}>{{localize 'ALTERNITY.Weapon.RangeClassSMG'}}</option>
                    </select>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Short'}}</label>
                        <input type="number" name="system.range.short" value="{{system.range.short}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Medium'}}</label>
                        <input type="number" name="system.range.medium" value="{{system.range.medium}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Long'}}</label>
                        <input type="number" name="system.range.long" value="{{system.range.long}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.TechPointCost'}}</label>
                        <input type="number" name="system.techPointCost" value="{{system.techPointCost}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weight'}}</label>
                        <input type="number" name="system.weight" value="{{system.weight}}" data-dtype="Number" min="0" step="0.1"/>
                    </div>
                </div>

                {{!-- What the weapon table prints besides the attack line.
                      Availability renders inline <option> markup rather than
                      {{selectOptions config.x}}: it mirrors the schema's own choices, and
                      an undefined config key makes selectOptions throw, which aborts the
                      render of this whole shared sheet for every item type. --}}
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.ProgressLevel'}}</label>
                        <input type="number" name="system.progressLevel" value="{{system.progressLevel}}" data-dtype="Number" min="0" max="9"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cost'}}</label>
                        <input type="number" name="system.cost" value="{{system.cost}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Availability'}}</label>
                        <select name="system.availability">
                            <option value="Any" {{#if (eq system.availability 'Any')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Any'}}</option>
                            <option value="Common" {{#if (eq system.availability 'Common')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Common'}}</option>
                            <option value="Controlled" {{#if (eq system.availability 'Controlled')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Controlled'}}</option>
                            <option value="Military" {{#if (eq system.availability 'Military')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Military'}}</option>
                            <option value="Restricted" {{#if (eq system.availability 'Restricted')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Restricted'}}</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    {{!-- Blank means the thing cannot be concealed at all, which the
                          tables print as a dash - not the same statement as a 0. --}}
                    <label title="{{localize 'ALTERNITY.ConcealmentHint'}}">{{localize 'ALTERNITY.Concealment'}}</label>
                    <input type="number" name="system.concealment" value="{{system.concealment}}" data-dtype="Number" placeholder="&mdash;"/>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label title="{{localize 'ALTERNITY.Weapon.FiringModesHint'}}">{{localize 'ALTERNITY.Weapon.FiringModes'}}</label>
                        <input type="text" name="system.firingModes" value="{{system.firingModes}}" data-dtype="String" placeholder="Full, Burst"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weapon.ClipSize'}}</label>
                        <input type="number" name="system.clipSize" value="{{system.clipSize}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weapon.ClipCost'}}</label>
                        <input type="number" name="system.clipCost" value="{{system.clipCost}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="form-group">
                    <label title="{{localize 'ALTERNITY.Weapon.ActionsToReadyHint'}}">{{localize 'ALTERNITY.Weapon.ActionsToReady'}}</label>
                    <input type="number" name="system.actionsToReady" value="{{system.actionsToReady}}" data-dtype="Number" min="0"/>
                </div>

                <div class="alt-item-summary">
                    {{!-- A situation-die step modifier, not a d20-style to-hit bonus:
                          the attack itself is a skill check rolled under the wielder's
                          (ability score + rank), which the character sheet resolves. --}}
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Weapon.TotalAttackBonus'}}:</strong> {{fmtMod system.totalAttackBonus}} {{localize 'ALTERNITY.Steps'}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Weapon.DamageRun'}}:</strong> {{system.damageRunLabel}}</span>
                    {{#if system.damageBonusFormula}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Weapon.DamageBonus'}}:</strong> {{system.damageBonusFormula}}</span>
                    {{/if}}
                    {{#if system.strengthDamageAdjustment}}
                        {{!-- Melee and thrown weapons only (PHB Table P9). --}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Weapon.StrengthDamage'}}:</strong> {{fmtMod system.strengthDamageAdjustment}}</span>
                    {{/if}}
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Range'}}:</strong> {{system.rangeDisplay}}</span>
                    {{#if system.usesTechPoints}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.TechPointCost'}}:</strong> {{system.techCostDisplay}}</span>
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq document.type 'armor')}}
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Armor.Type'}}</label>
                        <select name="system.armorType">
                            {{selectOptions config.armorTypes selected=system.armorType}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Armor.Toughness'}}</label>
                        {{!-- Inline <option> markup rather than {{selectOptions config.…}},
                              for the same reason damageCategory and attackAbility are:
                              a select must not depend on a config key introduced in the
                              same change as the markup. `selectOptions` calls
                              Object.entries on its argument, so one missing key throws
                              and takes the whole item sheet — every type — down with it. --}}
                        <select name="system.toughness">
                            <option value="Ordinary" {{#if (eq system.toughness 'Ordinary')}}selected{{/if}}>Ordinary</option>
                            <option value="Good" {{#if (eq system.toughness 'Good')}}selected{{/if}}>Good</option>
                            <option value="Amazing" {{#if (eq system.toughness 'Amazing')}}selected{{/if}}>Amazing</option>
                        </select>
                    </div>
                </div>

                {{!-- The armour rating proper: one die range per damage form, entered
                      exactly as the book prints it ("d6-1 (LI), d4 (HI), d4+1 (En)").
                      Text inputs, not numbers, because a die range is not a number. --}}
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Armor.Protection'}}</label>
                    <div class="grid grid-3col">
                        {{!-- Plain LI/HI/En here, not the ALTERNITY.Armor.LI keys: those
                              read "Armor LI", which is redundant under a Protection
                              heading, and they belong to the warship sheet. --}}
                        <label class="alt-item-inline-field">
                            <span>LI</span>
                            <input type="text" name="system.protection.li" value="{{system.protection.li}}" placeholder="d6-1"/>
                        </label>
                        <label class="alt-item-inline-field">
                            <span>HI</span>
                            <input type="text" name="system.protection.hi" value="{{system.protection.hi}}" placeholder="d4"/>
                        </label>
                        <label class="alt-item-inline-field">
                            <span>En</span>
                            <input type="text" name="system.protection.en" value="{{system.protection.en}}" placeholder="d4+1"/>
                        </label>
                    </div>
                    <p class="alt-item-hint">{{localize 'ALTERNITY.Armor.ProtectionHint'}}</p>
                </div>

                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.SpeedPenalty'}}</label>
                        <input type="number" name="system.speedPenalty" value="{{system.speedPenalty}}" data-dtype="Number" min="0" max="30"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Armor.SkillPenalty'}}</label>
                        <input type="number" name="system.skillPenalty" value="{{system.skillPenalty}}" data-dtype="Number" min="0" max="10"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Armor.ResistanceBonus'}}</label>
                    <input type="number" name="system.resistanceModifierBonus" value="{{system.resistanceModifierBonus}}" data-dtype="Number" min="0" max="5"/>
                    <p class="alt-item-hint">{{localize 'ALTERNITY.Armor.ResistanceBonusHint'}}</p>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.TechPointCost'}}</label>
                        <input type="number" name="system.techPointCost" value="{{system.techPointCost}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Weight'}}</label>
                        <input type="number" name="system.weight" value="{{system.weight}}" data-dtype="Number" min="0" step="0.1"/>
                    </div>
                </div>

                {{!-- What the armour table prints besides the protection ratings.
                      Availability renders inline <option> markup rather than
                      {{selectOptions config.x}}: it mirrors the schema's own choices, and
                      an undefined config key makes selectOptions throw, which aborts the
                      render of this whole shared sheet for every item type. --}}
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.ProgressLevel'}}</label>
                        <input type="number" name="system.progressLevel" value="{{system.progressLevel}}" data-dtype="Number" min="0" max="9"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cost'}}</label>
                        <input type="number" name="system.cost" value="{{system.cost}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Availability'}}</label>
                        <select name="system.availability">
                            <option value="Any" {{#if (eq system.availability 'Any')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Any'}}</option>
                            <option value="Common" {{#if (eq system.availability 'Common')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Common'}}</option>
                            <option value="Controlled" {{#if (eq system.availability 'Controlled')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Controlled'}}</option>
                            <option value="Military" {{#if (eq system.availability 'Military')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Military'}}</option>
                            <option value="Restricted" {{#if (eq system.availability 'Restricted')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Restricted'}}</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    {{!-- Blank means the thing cannot be concealed at all, which the
                          tables print as a dash - not the same statement as a 0. --}}
                    <label title="{{localize 'ALTERNITY.ConcealmentHint'}}">{{localize 'ALTERNITY.Concealment'}}</label>
                    <input type="number" name="system.concealment" value="{{system.concealment}}" data-dtype="Number" placeholder="&mdash;"/>
                </div>

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Armor.Protection'}}:</strong> {{system.protectionLabel}}</span>
                    {{#if system.raisesToughness}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Armor.Toughness'}}:</strong> {{system.toughness}}</span>
                    {{/if}}
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.SpeedPenalty'}}:</strong> {{system.speedPenaltyLabel}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Armor.SkillPenalty'}}:</strong> {{system.skillPenaltyLabel}}</span>
                    {{#if system.resistanceModifierBonus}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Armor.ResistanceBonus'}}:</strong> {{system.resistanceBonusLabel}}</span>
                    {{/if}}
                    {{#if system.usesTechPoints}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.TechPointCost'}}:</strong> {{system.techCostDisplay}}</span>
                    {{/if}}
                    {{#if system.hasUnreadable}}
                        <span class="alt-item-summary-entry alt-item-summary-warn">{{localize 'ALTERNITY.Armor.UnreadableRating'}}</span>
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq document.type 'computer')}}
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Computer.Processor'}}</label>
                    <input type="text" name="system.processorQuality" value="{{system.processorQuality}}" data-dtype="String"/>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Computer.Memory'}}</label>
                        <input type="number" name="system.activeMemory" value="{{system.activeMemory}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Computer.Storage'}}</label>
                        <input type="number" name="system.activeStorage" value="{{system.activeStorage}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                {{!-- What the hardware tables print alongside the specification.
                      Availability renders inline <option> markup rather than
                      {{selectOptions config.x}}: it mirrors the schema's own choices, and
                      an undefined config key makes selectOptions throw, which aborts the
                      render of this whole shared sheet for every item type. --}}
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.ProgressLevel'}}</label>
                        <input type="number" name="system.progressLevel" value="{{system.progressLevel}}" data-dtype="Number" min="0" max="9"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cost'}}</label>
                        <input type="number" name="system.cost" value="{{system.cost}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Availability'}}</label>
                        <select name="system.availability">
                            <option value="Any" {{#if (eq system.availability 'Any')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Any'}}</option>
                            <option value="Common" {{#if (eq system.availability 'Common')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Common'}}</option>
                            <option value="Controlled" {{#if (eq system.availability 'Controlled')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Controlled'}}</option>
                            <option value="Military" {{#if (eq system.availability 'Military')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Military'}}</option>
                            <option value="Restricted" {{#if (eq system.availability 'Restricted')}}selected{{/if}}>{{localize 'ALTERNITY.AvailabilityClass.Restricted'}}</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Computer.Programs'}}</label>
                    {{#if systemFields.programs}}
                        {{formInput systemFields.programs value=system.programs name="system.programs"}}
                    {{else}}
                        <textarea name="system.programs" rows="10">{{system.programs}}</textarea>
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq document.type 'skill')}}
                <div class="form-group">
                    <label title="{{localize 'ALTERNITY.Skill.BaseCostHint'}}">{{localize 'ALTERNITY.Skill.BaseCost'}}</label>
                    <input type="number" name="system.baseCost" value="{{system.baseCost}}" data-dtype="Number" min="0" max="15"/>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Skill.SkillId'}}</label>
                        <select name="system.skillId">
                            <option value="">&mdash;</option>
