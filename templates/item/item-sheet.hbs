                    {{/if}}
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Cybertech.Status'}}:</strong> {{system.statusLabel}}</span>
                </div>
            {{/if}}

            {{!-- ─── Program (PHB Ch.10; Dataware) ─────────────────────────────
                  Selects use inline <option> markup for the same reason cybertech's
                  do: an undefined config key makes selectOptions throw, which aborts
                  the render of this whole shared sheet for every item type. --}}
            {{#if (eq document.type 'program')}}
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.Category'}}</label>
                        <select name="system.category">
                            <option value="Operator" {{#if (eq system.category 'Operator')}}selected{{/if}}>{{localize 'ALTERNITY.Program.CategoryOperator'}}</option>
                            <option value="Hacking" {{#if (eq system.category 'Hacking')}}selected{{/if}}>{{localize 'ALTERNITY.Program.CategoryHacking'}}</option>
                            <option value="Utility" {{#if (eq system.category 'Utility')}}selected{{/if}}>{{localize 'ALTERNITY.Program.CategoryUtility'}}</option>
                            <option value="Artificial Intelligence" {{#if (eq system.category 'Artificial Intelligence')}}selected{{/if}}>{{localize 'ALTERNITY.Program.CategoryAI'}}</option>
                            <option value="Robot" {{#if (eq system.category 'Robot')}}selected{{/if}}>{{localize 'ALTERNITY.Program.CategoryRobot'}}</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.Quality'}}</label>
                        <select name="system.quality">
                            <option value="Marginal" {{#if (eq system.quality 'Marginal')}}selected{{/if}}>{{localize 'ALTERNITY.Quality.Marginal'}}</option>
                            <option value="Ordinary" {{#if (eq system.quality 'Ordinary')}}selected{{/if}}>{{localize 'ALTERNITY.Quality.Ordinary'}}</option>
                            <option value="Good" {{#if (eq system.quality 'Good')}}selected{{/if}}>{{localize 'ALTERNITY.Quality.Good'}}</option>
                            <option value="Amazing" {{#if (eq system.quality 'Amazing')}}selected{{/if}}>{{localize 'ALTERNITY.Quality.Amazing'}}</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-3col">
                    {{!-- A text input, not a number: the book prints "6/8" and "varies"
                          as often as it prints a plain integer. --}}
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.ProgressLevel'}}</label>
                        <input type="text" name="system.progressLevel" value="{{system.progressLevel}}" data-dtype="String" placeholder="5"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.Slots'}}</label>
                        <input type="number" name="system.slots" value="{{system.slots}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.Cost'}}</label>
                        <input type="number" name="system.cost" value="{{system.cost}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.Availability'}}</label>
                        <select name="system.availability">
                            <option value="Any" {{#if (eq system.availability 'Any')}}selected{{/if}}>{{localize 'ALTERNITY.Program.AvailAny'}}</option>
                            <option value="Common" {{#if (eq system.availability 'Common')}}selected{{/if}}>{{localize 'ALTERNITY.Program.AvailCommon'}}</option>
                            <option value="Controlled" {{#if (eq system.availability 'Controlled')}}selected{{/if}}>{{localize 'ALTERNITY.Program.AvailControlled'}}</option>
                            <option value="Military" {{#if (eq system.availability 'Military')}}selected{{/if}}>{{localize 'ALTERNITY.Program.AvailMilitary'}}</option>
                            <option value="Restricted" {{#if (eq system.availability 'Restricted')}}selected{{/if}}>{{localize 'ALTERNITY.Program.AvailRestricted'}}</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.Automation'}}</label>
                        <select name="system.automation">
                            <option value="None" {{#if (eq system.automation 'None')}}selected{{/if}}>{{localize 'ALTERNITY.Program.AutomationNone'}}</option>
                            <option value="Optional" {{#if (eq system.automation 'Optional')}}selected{{/if}}>{{localize 'ALTERNITY.Program.AutomationOptional'}}</option>
                            <option value="Required" {{#if (eq system.automation 'Required')}}selected{{/if}}>{{localize 'ALTERNITY.Program.AutomationRequired'}}</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Program.Tagline'}}</label>
                    <input type="text" name="system.tagline" value="{{system.tagline}}" data-dtype="String" placeholder="Tags and removes an intruder from a domain."/>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.Program.Payload'}}</h3>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Roll.Ordinary'}}</label>
                        <input type="text" name="system.damage.ordinary" value="{{system.damage.ordinary}}" data-dtype="String" placeholder="d4s"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Roll.Good'}}</label>
                        <input type="text" name="system.damage.good" value="{{system.damage.good}}" data-dtype="String" placeholder="d4+2s"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Roll.Amazing'}}</label>
                        <input type="text" name="system.damage.amazing" value="{{system.damage.amazing}}" data-dtype="String" placeholder="d6+2s"/>
                    </div>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.SkillScore'}}</label>
                        <input type="number" name="system.skillScore" value="{{system.skillScore}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.ExtraSuccesses'}}</label>
                        <input type="number" name="system.extraSuccesses" value="{{system.extraSuccesses}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.TailoredBonus'}}</label>
                        <input type="number" name="system.tailoring.bonusSteps" value="{{system.tailoring.bonusSteps}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Program.TailoredTarget'}}</label>
                    <input type="text" name="system.tailoring.target" value="{{system.tailoring.target}}" data-dtype="String" placeholder="New Ursa Bank datacores"/>
                </div>
                {{!-- Leave all three at 0 to use the quality default (Marginal 2/2/1,
                      Ordinary 4/4/2, Good 6/6/3, Amazing 8/8/4). --}}
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.BonusStun'}}</label>
                        <input type="number" name="system.durability.stun" value="{{system.durability.stun}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.BonusWound'}}</label>
                        <input type="number" name="system.durability.wound" value="{{system.durability.wound}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Cybertech.BonusMortal'}}</label>
                        <input type="number" name="system.durability.mortal" value="{{system.durability.mortal}}" data-dtype="Number" min="0"/>
                    </div>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.Program.Requirements'}}</h3>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.RequiredSkill'}}</label>
                        <input type="text" name="system.requiredSkill" value="{{system.requiredSkill}}" data-dtype="String" placeholder="Computer Science-hacking"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.RequiredRank'}}</label>
                        <input type="number" name="system.requiredRank" value="{{system.requiredRank}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Program.RequiredHardware'}}</label>
                        <input type="text" name="system.requiredHardware" value="{{system.requiredHardware}}" data-dtype="String" placeholder="mainframe"/>
                    </div>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.Program.Status'}}</h3>
                <div class="alt-checkbox-row">
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.isLoaded" data-dtype="Boolean" {{#if system.isLoaded}}checked{{/if}}/>
                        {{localize 'ALTERNITY.Program.IsLoaded'}}
                    </label>
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.isBuggy" data-dtype="Boolean" {{#if system.isBuggy}}checked{{/if}}/>
                        {{localize 'ALTERNITY.Program.IsBuggy'}}
                    </label>
                </div>

                <div class="alt-item-summary">
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Program.Quality'}}:</strong> {{system.quality}} &mdash; {{system.plLabel}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Program.Slots'}}:</strong> {{system.slotsDisplay}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Program.StepModifier'}}:</strong> {{system.stepModifierDisplay}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Program.Cost'}}:</strong> {{system.costDisplay}}</span>
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Program.Durability'}}:</strong> {{system.durabilityDisplay}}{{#if system.usesDefaultDurability}} ({{localize 'ALTERNITY.Program.DefaultDurability'}}){{/if}}</span>
                    {{#if system.hasDamage}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.DamageFormula'}}:</strong> {{system.damageDisplay}}</span>
                    {{/if}}
                    {{#if system.isAutonomous}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Program.SkillScore'}}:</strong> {{system.skillScore}}</span>
                    {{/if}}
                    {{#if system.isTailored}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Program.Tailored'}}:</strong> {{system.tailoringDisplay}}</span>
                    {{/if}}
                    {{#if system.hasRequirements}}
                        <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Program.Requirements'}}:</strong> {{system.requirementsDisplay}}</span>
                    {{/if}}
                    <span class="alt-item-summary-entry"><strong>{{localize 'ALTERNITY.Program.Status'}}:</strong> {{system.statusLabel}}</span>
                </div>
            {{/if}}

            {{!-- ─── FX power (Mindwalking; GM Guide Ch.16) ────────────────── --}}
            {{#if (eq document.type 'fx')}}
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.Tradition'}}</label>
                        <select name="system.tradition">
                            <option value="Psionic" {{#if (eq system.tradition 'Psionic')}}selected{{/if}}>{{localize 'ALTERNITY.FX.TraditionPsionic'}}</option>
                            <option value="Arcane Magic" {{#if (eq system.tradition 'Arcane Magic')}}selected{{/if}}>{{localize 'ALTERNITY.FX.TraditionArcane'}}</option>
                            <option value="Faith" {{#if (eq system.tradition 'Faith')}}selected{{/if}}>{{localize 'ALTERNITY.FX.TraditionFaith'}}</option>
                            <option value="Super Power" {{#if (eq system.tradition 'Super Power')}}selected{{/if}}>{{localize 'ALTERNITY.FX.TraditionSuper'}}</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.BroadSkill'}}</label>
                        <select name="system.broadSkill">
                            <option value="Biokinesis" {{#if (eq system.broadSkill 'Biokinesis')}}selected{{/if}}>Biokinesis</option>
                            <option value="Extrasensory Perception" {{#if (eq system.broadSkill 'Extrasensory Perception')}}selected{{/if}}>Extrasensory Perception</option>
                            <option value="Psychoportation" {{#if (eq system.broadSkill 'Psychoportation')}}selected{{/if}}>Psychoportation</option>
                            <option value="Telekinesis" {{#if (eq system.broadSkill 'Telekinesis')}}selected{{/if}}>Telekinesis</option>
                            <option value="Telepathy" {{#if (eq system.broadSkill 'Telepathy')}}selected{{/if}}>Telepathy</option>
                            <option value="Arcane Magic" {{#if (eq system.broadSkill 'Arcane Magic')}}selected{{/if}}>Arcane Magic</option>
                            <option value="Faith" {{#if (eq system.broadSkill 'Faith')}}selected{{/if}}>Faith</option>
                            <option value="Super Power" {{#if (eq system.broadSkill 'Super Power')}}selected{{/if}}>Super Power</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.LinkedAbility'}}</label>
                        <select name="system.linkedAbility">
                            <option value="STR" {{#if (eq system.linkedAbility 'STR')}}selected{{/if}}>STR</option>
                            <option value="DEX" {{#if (eq system.linkedAbility 'DEX')}}selected{{/if}}>DEX</option>
                            <option value="CON" {{#if (eq system.linkedAbility 'CON')}}selected{{/if}}>CON</option>
                            <option value="INT" {{#if (eq system.linkedAbility 'INT')}}selected{{/if}}>INT</option>
                            <option value="WIL" {{#if (eq system.linkedAbility 'WIL')}}selected{{/if}}>WIL</option>
                            <option value="PER" {{#if (eq system.linkedAbility 'PER')}}selected{{/if}}>PER</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.Rank'}}</label>
                        <input type="number" name="system.rank" value="{{system.rank}}" data-dtype="Number" min="0" max="12"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.Category'}}</label>
                        <input type="text" name="system.category" value="{{system.category}}" data-dtype="String" placeholder="Conjure"/>
                    </div>
                </div>
                <div class="alt-checkbox-row">
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.isBroadSkill" data-dtype="Boolean" {{#if system.isBroadSkill}}checked{{/if}}/>
                        {{localize 'ALTERNITY.FX.IsBroadSkill'}}
                    </label>
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.cannotBeUsedUntrained" data-dtype="Boolean" {{#if system.cannotBeUsedUntrained}}checked{{/if}}/>
                        {{localize 'ALTERNITY.FX.CannotBeUsedUntrained'}}
                    </label>
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.hasExtendedDuration" data-dtype="Boolean" {{#if system.hasExtendedDuration}}checked{{/if}}/>
                        {{localize 'ALTERNITY.FX.ExtendedDuration'}}
                    </label>
                    <label class="alt-checkbox-inline">
                        <input type="checkbox" name="system.requiresVisualRange" data-dtype="Boolean" {{#if system.requiresVisualRange}}checked{{/if}}/>
                        {{localize 'ALTERNITY.FX.VisualRange'}}
                    </label>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.FX.Energy'}}</h3>
                <div class="grid grid-3col">
                    {{!-- 0 = use the flat table (2 for a broad skill use, 1 for a specialty). --}}
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.EnergyOverride'}}</label>
                        <input type="number" name="system.energyCostOverride" value="{{system.energyCostOverride}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.Maintenance'}}</label>
                        <input type="text" name="system.maintenanceCost" value="{{system.maintenanceCost}}" data-dtype="String" placeholder="1 point per round"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.BaseCost'}}</label>
                        <input type="number" name="system.baseCost" value="{{system.baseCost}}" data-dtype="Number" min="0" max="15"/>
                    </div>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.FX.Targeting'}}</h3>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.RangeShort'}}</label>
                        <input type="number" name="system.range.short" value="{{system.range.short}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.RangeMedium'}}</label>
                        <input type="number" name="system.range.medium" value="{{system.range.medium}}" data-dtype="Number" min="0"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.RangeLong'}}</label>
                        <input type="number" name="system.range.long" value="{{system.range.long}}" data-dtype="Number" min="0"/>
                    </div>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.Area'}}</label>
                        <input type="text" name="system.area" value="{{system.area}}" data-dtype="String" placeholder="2 m diameter"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.Target'}}</label>
                        <input type="text" name="system.target" value="{{system.target}}" data-dtype="String" placeholder="One creature"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.Duration'}}</label>
                        <input type="text" name="system.duration" value="{{system.duration}}" data-dtype="String" placeholder="d4 rounds"/>
                    </div>
                </div>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.Resistance'}}</label>
                        <select name="system.resistance">
                            <option value="None" {{#if (eq system.resistance 'None')}}selected{{/if}}>&mdash;</option>
                            <option value="Will" {{#if (eq system.resistance 'Will')}}selected{{/if}}>Will</option>
                            <option value="Dexterity" {{#if (eq system.resistance 'Dexterity')}}selected{{/if}}>Dexterity</option>
                            <option value="Strength" {{#if (eq system.resistance 'Strength')}}selected{{/if}}>Strength</option>
                            <option value="Constitution" {{#if (eq system.resistance 'Constitution')}}selected{{/if}}>Constitution</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.MentalCombat'}}</label>
                        <select name="system.mentalCombatClass">
                            <option value="None" {{#if (eq system.mentalCombatClass 'None')}}selected{{/if}}>&mdash;</option>
                            <option value="Assault" {{#if (eq system.mentalCombatClass 'Assault')}}selected{{/if}}>{{localize 'ALTERNITY.FX.MentalAssault'}}</option>
                            <option value="Subversion" {{#if (eq system.mentalCombatClass 'Subversion')}}selected{{/if}}>{{localize 'ALTERNITY.FX.MentalSubversion'}}</option>
                            <option value="Trap" {{#if (eq system.mentalCombatClass 'Trap')}}selected{{/if}}>{{localize 'ALTERNITY.FX.MentalTrap'}}</option>
                            <option value="Defense" {{#if (eq system.mentalCombatClass 'Defense')}}selected{{/if}}>{{localize 'ALTERNITY.FX.MentalDefense'}}</option>
                        </select>
                    </div>
                </div>

                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.FX.Damage'}}</h3>
                <div class="grid grid-2col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.FX.DamageType'}}</label>
                        <select name="system.damageType">
                            <option value="None" {{#if (eq system.damageType 'None')}}selected{{/if}}>&mdash;</option>
                            <option value="LI" {{#if (eq system.damageType 'LI')}}selected{{/if}}>LI</option>
                            <option value="HI" {{#if (eq system.damageType 'HI')}}selected{{/if}}>HI</option>
                            <option value="En" {{#if (eq system.damageType 'En')}}selected{{/if}}>En</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-3col">
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Roll.Ordinary'}}</label>
                        <input type="text" name="system.damage.ordinary" value="{{system.damage.ordinary}}" data-dtype="String" placeholder="d4s"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Roll.Good'}}</label>
                        <input type="text" name="system.damage.good" value="{{system.damage.good}}" data-dtype="String" placeholder="d4+2s"/>
                    </div>
                    <div class="form-group">
                        <label>{{localize 'ALTERNITY.Roll.Amazing'}}</label>
                        <input type="text" name="system.damage.amazing" value="{{system.damage.amazing}}" data-dtype="String" placeholder="d4w"/>
                    </div>
                </div>

                {{!-- Every catalogued power spells out what each degree of success
                      does — this is the most important text on the card. --}}
                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.FX.Outcomes'}}</h3>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Roll.Ordinary'}}</label>
                    <textarea name="system.outcomes.ordinary" data-dtype="String" rows="2">{{system.outcomes.ordinary}}</textarea>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Roll.Good'}}</label>
                    <textarea name="system.outcomes.good" data-dtype="String" rows="2">{{system.outcomes.good}}</textarea>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Roll.Amazing'}}</label>
                    <textarea name="system.outcomes.amazing" data-dtype="String" rows="2">{{system.outcomes.amazing}}</textarea>
                </div>
                <div class="form-group">
                    <label>{{localize 'ALTERNITY.Roll.CriticalFailure'}}</label>
                    <textarea name="system.criticalFailure" data-dtype="String" rows="2">{{system.criticalFailure}}</textarea>
                </div>

                {{!-- Rank benefits unlock automatically as rank rises; they cannot be
                      pre-purchased, so unlocked/locked is derived from `rank`. --}}
                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.FX.RankBenefits'}}</h3>
                <div class="alt-item-array-table">
                    {{!-- Bind to row.index (position in the stored array), NOT the
                          loop index: these rows are displayed in rank order. --}}
                    {{#each system.sortedRankBenefits as |row|}}
                    <div class="alt-item-array-row{{#unless row.isUnlocked}} alt-item-array-row-locked{{/unless}}">
                        <input type="number" name="system.rankBenefits.{{row.index}}.rank" value="{{row.rank}}" data-dtype="Number" min="0" max="12" class="alt-item-array-narrow" title="{{localize 'ALTERNITY.FX.Rank'}}"/>
                        <input type="text" name="system.rankBenefits.{{row.index}}.name" value="{{row.name}}" data-dtype="String" placeholder="Increased Damage"/>
                        <input type="text" name="system.rankBenefits.{{row.index}}.description" value="{{row.description}}" data-dtype="String" placeholder="At rank 5, damage becomes…"/>
                        <a class="alt-item-array-delete" data-action="deleteArrayRow" data-array="rankBenefits" data-index="{{row.index}}" data-tooltip="{{localize 'ALTERNITY.DeleteRow'}}"><i class="fas fa-times"></i></a>
                    </div>
                    {{/each}}
                    <a class="alt-item-array-add" data-action="addArrayRow" data-array="rankBenefits">+ {{localize 'ALTERNITY.FX.AddRankBenefit'}}</a>
                </div>

                {{!-- Trappings are a GM Guide Ch.16 concept; psionic powers have none. --}}
                {{#unless (eq system.tradition 'Psionic')}}
                <h3 class="alt-item-subhead">{{localize 'ALTERNITY.FX.Trappings'}}</h3>
                <div class="alt-checkbox-row">
                    <label class="alt-checkbox-inline"><input type="checkbox" name="system.trappings.ritual" data-dtype="Boolean" {{#if system.trappings.ritual}}checked{{/if}}/> {{localize 'ALTERNITY.FX.TrappingRitual'}}</label>
                    <label class="alt-checkbox-inline"><input type="checkbox" name="system.trappings.word" data-dtype="Boolean" {{#if system.trappings.word}}checked{{/if}}/> {{localize 'ALTERNITY.FX.TrappingWord'}}</label>
                    <label class="alt-checkbox-inline"><input type="checkbox" name="system.trappings.will" data-dtype="Boolean" {{#if system.trappings.will}}checked{{/if}}/> {{localize 'ALTERNITY.FX.TrappingWill'}}</label>
                    <label class="alt-checkbox-inline"><input type="checkbox" name="system.trappings.component" data-dtype="Boolean" {{#if system.trappings.component}}checked{{/if}}/> {{localize 'ALTERNITY.FX.TrappingComponent'}}</label>
                    <label class="alt-checkbox-inline"><input type="checkbox" name="system.trappings.focus" data-dtype="Boolean" {{#if system.trappings.focus}}checked{{/if}}/> {{localize 'ALTERNITY.FX.TrappingFocus'}}</label>
