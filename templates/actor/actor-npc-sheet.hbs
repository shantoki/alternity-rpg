<form class="{{cssClass}} {{alt}}-sheet {{alt}}-npc-sheet" autocomplete="off">
    {{!-- NPC Sheet Header --}}
    <header class="{{alt}}-sheet-header">
        <div class="{{alt}}-sheet-portrait">
            <img src="{{actor.img}}" data-edit="img" alt="{{actor.name}}" />
        </div>
        <div class="{{alt}}-sheet-identity">
            <h1 class="{{alt}}-sheet-name">
                <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}" spellcheck="false" />
            </h1>
            <div class="{{alt}}-sheet-meta">
                <span class="{{alt}}-wound-badge {{alt}}-wound-badge--{{woundSeverity}}">
                    {{localize (concat 'ALTERNITY.' system.woundLevel)}}
                </span>
                {{#if system.isIncapacitated}}<span class="{{alt}}-incap-warning">⚠ {{localize 'ALTERNITY.Incapacitated'}}</span>{{/if}}
                
                <div class="{{alt}}-meta-field">
                    <label>CR</label>
                    <select name="system.cr">
                        {{#each crChoices as |choice|}}
                        <option value="{{choice}}" {{#if (eq ../system.cr choice)}}selected{{/if}}>{{choice}}</option>
                        {{/each}}
                    </select>
                </div>
            </div>
            
            <div class="{{alt}}-npc-combat-summary">
                <div class="{{alt}}-stat-box">
                    <label>{{localize 'ALTERNITY.ResistanceModifier'}}</label>
                    <div class="{{alt}}-stat-combined">
                        {{!-- A step penalty applied to attackers, not an armor class:
                              DEX's resistance modifier plus this NPC's flat bonus. --}}
                        <strong>{{fmtMod system.resistanceModifier}}</strong>
                        <span class="{{alt}}-stat-sub">({{localize 'ALTERNITY.Bonus'}}: <input type="number" name="system.defenseBonus" value="{{system.defenseBonus}}" />)</span>
                    </div>
                </div>
                <div class="{{alt}}-stat-box">
                    <label>{{localize 'ALTERNITY.Attack'}}</label>
                    <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" />
                </div>
                <div class="{{alt}}-stat-box">
                    <label>{{localize 'ALTERNITY.Damage'}}</label>
                    <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" />
                </div>
                <div class="{{alt}}-stat-box">
                    <label>{{localize 'ALTERNITY.Actions'}}</label>
                    <input type="number" name="system.actionsPerRound" value="{{system.actionsPerRound}}" min="1" />
                </div>
            </div>
        </div>
    </header>

    {{!-- NPC Resources --}}
    <section class="{{alt}}-resources">
        {{!-- The four damage tracks a supporting-cast statblock prints as
              `Durability: 9/9/5/5` (stun/wound/mortal/fatigue). These were
              formerly two bars named stamina/vitality, which are not game terms —
              they were stun and wound all along. --}}
        <div class="{{alt}}-resource-bar bar--stun">
            <div class="{{alt}}-bar-label">
                <span class="{{alt}}-bar-name">{{localize 'ALTERNITY.Durability.Stun'}}</span>
                <span class="{{alt}}-bar-values">
                    <input type="number" name="system.durability.stun.value" value="{{system.durability.stun.value}}" data-dtype="Number" min="0" />
                    <span>/</span>
                    <input type="number" name="system.durability.stun.max" value="{{system.durability.stun.max}}" data-dtype="Number" min="0" />
                </span>
            </div>
            <div class="{{alt}}-bar-track">
                <div class="{{alt}}-bar-fill" style="width: {{pct system.durability.stun.value system.durability.stun.max}}"></div>
            </div>
        </div>
        <div class="{{alt}}-resource-bar bar--wound">
            <div class="{{alt}}-bar-label">
                <span class="{{alt}}-bar-name">{{localize 'ALTERNITY.Durability.Wound'}}</span>
                <span class="{{alt}}-bar-values">
                    <input type="number" name="system.durability.wound.value" value="{{system.durability.wound.value}}" data-dtype="Number" min="0" />
                    <span>/</span>
                    <input type="number" name="system.durability.wound.max" value="{{system.durability.wound.max}}" data-dtype="Number" min="0" />
                </span>
            </div>
            <div class="{{alt}}-bar-track">
                <div class="{{alt}}-bar-fill" style="width: {{pct system.durability.wound.value system.durability.wound.max}}"></div>
            </div>
        </div>
        <div class="{{alt}}-resource-bar bar--mortal">
            <div class="{{alt}}-bar-label">
                <span class="{{alt}}-bar-name">{{localize 'ALTERNITY.Durability.Mortal'}}</span>
                <span class="{{alt}}-bar-values">
                    <input type="number" name="system.durability.mortal.value" value="{{system.durability.mortal.value}}" data-dtype="Number" min="0" />
                    <span>/</span>
                    <input type="number" name="system.durability.mortal.max" value="{{system.durability.mortal.max}}" data-dtype="Number" min="0" />
                </span>
            </div>
            <div class="{{alt}}-bar-track">
                <div class="{{alt}}-bar-fill" style="width: {{pct system.durability.mortal.value system.durability.mortal.max}}"></div>
            </div>
        </div>
        <div class="{{alt}}-resource-bar bar--fatigue">
            <div class="{{alt}}-bar-label">
                <span class="{{alt}}-bar-name">{{localize 'ALTERNITY.Durability.Fatigue'}}</span>
                <span class="{{alt}}-bar-values">
                    <input type="number" name="system.durability.fatigue.value" value="{{system.durability.fatigue.value}}" data-dtype="Number" min="0" />
                    <span>/</span>
                    <input type="number" name="system.durability.fatigue.max" value="{{system.durability.fatigue.max}}" data-dtype="Number" min="0" />
                </span>
            </div>
            <div class="{{alt}}-bar-track">
                <div class="{{alt}}-bar-fill" style="width: {{pct system.durability.fatigue.value system.durability.fatigue.max}}"></div>
            </div>
        </div>
    </section>

    {{!-- Wound Track --}}
    <div class="{{alt}}-wound-track">
        {{#each WOUND_LEVELS as |w|}}
        <button type="button" class="{{../alt}}-wound-pip {{#if (eq w ../system.woundLevel)}}active{{/if}} {{../alt}}-wound-pip--{{lookup ../WOUND_SEVERITY w}}"
                data-action="setWound" data-wound="{{w}}"
                title="{{localize (concat 'ALTERNITY.' w)}}">{{firstChar w}}</button>
        {{/each}}
    </div>

    {{!-- NPC Content --}}
    <section class="{{alt}}-sheet-body">
        <div class="{{alt}}-npc-main-content">
            <div class="{{alt}}-abilities-grid">
                {{#each system.abilities as |val key|}}
                <div class="{{../alt}}-ability-box">
                    <span class="{{../alt}}-ability-label">{{key}}</span>
                    <input type="number" name="system.abilities.{{key}}" value="{{val}}" min="-3" max="6" />
                </div>
                {{/each}}
            </div>

            <div class="{{alt}}-npc-stats-extras">
                <div class="{{alt}}-stat-row">
                    <label>{{localize 'ALTERNITY.Morale'}}</label>
                    <input type="number" name="system.morale" value="{{system.morale}}" min="0" max="100" />
                </div>
                <div class="{{alt}}-stat-row">
                    <label>{{localize 'ALTERNITY.XP'}}</label>
                    <input type="number" name="system.rewardXP" value="{{system.rewardXP}}" min="0" />
                </div>
                <div class="{{alt}}-stat-row">
                    <label>{{localize 'ALTERNITY.Elite'}}</label>
                    <input type="checkbox" name="system.isElite" {{checked system.isElite}} />
                </div>
            </div>
        </div>

        <div class="{{alt}}-npc-tabs">
            <nav class="{{alt}}-sheet-nav" data-group="primary">
                <a class="item {{#if (eq activeTab 'tactics')}}active{{/if}}" data-tab="tactics" data-action="switchTab">{{localize 'ALTERNITY.Tactics'}}</a>
                <a class="item {{#if (eq activeTab 'biography')}}active{{/if}}" data-tab="biography" data-action="switchTab">{{localize 'ALTERNITY.Biography'}}</a>
            </nav>
            <section class="tab-content">
                <div class="tab" data-tab="tactics">
                    {{editor system.tactics target="system.tactics" button=true owner=owner editable=editable}}
                </div>
                <div class="tab" data-tab="biography">
                    {{editor system.biography target="system.biography" button=true owner=owner editable=editable}}
                </div>
            </section>
        </div>
    </section>
</form>
