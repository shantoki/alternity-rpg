{{!--
    Supporting cast record sheet.

    Laid out in the order the Gamemaster Guide prints a supporting-character
    statblock: identity and quality tier, abilities, the derived statblock run
    (durability / action check / move / actions / reaction score), then attacks and
    Gamemaster notes. Skills are deliberately absent — supporting cast use the hero
    skill tree in AlternityCharacterState, not a second list.

    Root is a plain <div>: the ApplicationV2 root is already a <form>.
--}}
<div class="{{cssClass}} {{alt}}-sheet {{alt}}-npc-sheet">

    {{!-- ═══ Header ════════════════════════════════════════════════════════ --}}
    <header class="{{alt}}-sheet-header">
        <div class="{{alt}}-sheet-portrait">
            <img src="{{actor.img}}" data-edit="img" alt="{{actor.name}}" />
        </div>
        <div class="{{alt}}-sheet-identity">
            <h1 class="{{alt}}-sheet-name">
                <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}" spellcheck="false" />
            </h1>
            <div class="{{alt}}-sheet-meta">
                <div class="{{alt}}-meta-field">
                    <label title="{{localize 'ALTERNITY.Npc.QualityHint'}}">{{localize 'ALTERNITY.Npc.Quality'}}</label>
                    <select name="system.quality">
                        {{#each qualityChoices as |choice|}}
                        <option value="{{choice.key}}" {{#if (eq ../system.quality choice.key)}}selected{{/if}}>{{choice.label}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="{{alt}}-meta-field">
                    <label title="{{localize 'ALTERNITY.Npc.RoleHint'}}">{{localize 'ALTERNITY.Npc.Role'}}</label>
                    <select name="system.role">
                        {{#each roleChoices as |choice|}}
                        <option value="{{choice}}" {{#if (eq ../system.role choice)}}selected{{/if}}>{{localize (concat 'ALTERNITY.Npc.RoleName.' choice)}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="{{alt}}-meta-field">
                    <label title="{{localize 'ALTERNITY.Npc.ProfessionHint'}}">{{localize 'ALTERNITY.Npc.Profession'}}</label>
                    <select name="system.profession">
                        {{#each professionChoices as |choice|}}
                        <option value="{{choice}}" {{#if (eq ../system.profession choice)}}selected{{/if}}>{{choice}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="{{alt}}-meta-field">
                    <label>{{localize 'ALTERNITY.Npc.Level'}}</label>
                    <input type="number" name="system.level" value="{{system.level}}" min="0" />
                </div>
                <span class="{{alt}}-wound-badge {{alt}}-wound-badge--{{woundSeverity}}">
                    {{localize (concat 'ALTERNITY.' system.woundLevel)}}
                </span>
            </div>
        </div>
    </header>

    <main class="{{alt}}-sheet-body">

        {{!-- ═══ Quality tier readout ══════════════════════════════════════ --}}
        {{#each qualityChoices as |choice|}}
        {{#if (eq ../system.quality choice.key)}}
        <p class="{{../alt}}-npc-tier-hint">{{choice.hint}}</p>
        {{/if}}
        {{/each}}

        {{#if professionBonusSuppressed}}
        <p class="{{alt}}-ship-warning is-soft">{{localize 'ALTERNITY.Npc.WarnMarginalNonprofessional'}}</p>
        {{/if}}

        {{!-- ═══ Abilities ═════════════════════════════════════════════════ --}}
        <section class="{{alt}}-robot-abilities">
            {{#each abilities as |a|}}
            <div class="{{../alt}}-robot-ability">
                <label title="{{a.label}}">{{a.key}}</label>
                <input type="number" name="system.abilities.{{a.key}}" value="{{a.value}}" min="0" max="30" />
            </div>
            {{/each}}
        </section>

        {{!-- ═══ The printed statblock run ═════════════════════════════════ --}}
        <section class="{{alt}}-stats-grid">
            <div class="{{alt}}-stat-box">
                <label title="{{localize 'ALTERNITY.Npc.DurabilityHint'}}">{{localize 'ALTERNITY.Npc.Durability'}}</label>
                <strong>{{system.durabilityRun}}</strong>
            </div>
            <div class="{{alt}}-stat-box">
                <label title="{{localize 'ALTERNITY.Npc.ActionCheckHint'}}">{{localize 'ALTERNITY.Npc.ActionCheck'}}</label>
                <strong>{{system.actionCheck.marginal}}+ / {{system.actionCheck.ordinary}} / {{system.actionCheck.good}} / {{system.actionCheck.amazing}}</strong>
                <span class="{{alt}}-ai-note">
                    {{system.actionCheck.base}} {{localize 'ALTERNITY.Npc.FromAbilities'}}
                    {{fmtMod system.actionCheck.professionBonus}} {{localize 'ALTERNITY.Npc.FromProfession'}}
                </span>
            </div>
            <div class="{{alt}}-stat-box">
                <label title="{{localize 'ALTERNITY.Npc.ActionsPerRoundHint'}}">{{localize 'ALTERNITY.Npc.ActionsPerRound'}}</label>
                <input type="number" name="system.actionsPerRound" value="{{system.actionsPerRound}}" min="1" />
            </div>
            <div class="{{alt}}-stat-box">
                <label title="{{localize 'ALTERNITY.Npc.ReactionScoreHint'}}">{{localize 'ALTERNITY.Npc.ReactionScore'}}</label>
                <select name="system.reactionDegree">
                    {{#each reactionDegreeChoices as |choice|}}
                    <option value="{{choice}}" {{#if (eq ../system.reactionDegree choice)}}selected{{/if}}>{{choice}}</option>
                    {{/each}}
                </select>
                <span class="{{alt}}-ai-note">/ {{system.reactionScore.number}}</span>
            </div>
            <div class="{{alt}}-stat-box">
                <label title="{{localize 'ALTERNITY.Npc.ResistanceHint'}}">{{localize 'ALTERNITY.Npc.Resistance'}}</label>
                <strong>{{fmtMod system.resistanceModifier}}</strong>
                <span class="{{alt}}-ai-note">
                    {{localize 'ALTERNITY.Npc.FlatBonus'}}
                    <input type="number" name="system.resistanceBonus" value="{{system.resistanceBonus}}" />
                </span>
            </div>
            <div class="{{alt}}-stat-box">
                <label title="{{localize 'ALTERNITY.Npc.ActionCheckOverrideHint'}}">{{localize 'ALTERNITY.Npc.ActionCheckOverride'}}</label>
                <input type="number" name="system.actionCheckBonusOverride" value="{{system.actionCheckBonusOverride}}" placeholder="—" />
            </div>
            <div class="{{alt}}-stat-box {{alt}}-stat-box--wide">
                <label title="{{localize 'ALTERNITY.Npc.LastResortHint'}}">{{localize 'ALTERNITY.LastResort.Label'}}</label>
                <span class="{{alt}}-npc-inline-pair">
                    <input type="number" name="system.lastResort.value" value="{{system.lastResort.value}}" min="0" max="5" />
                    /
                    <input type="number" name="system.lastResort.max" value="{{system.lastResort.max}}" min="0" max="5" />
                </span>
            </div>
            <div class="{{alt}}-stat-box {{alt}}-stat-box--wide">
                <label title="{{localize 'ALTERNITY.Npc.SuperiorDurabilityHint'}}">{{localize 'ALTERNITY.Npc.SuperiorDurability'}}</label>
                <label class="{{alt}}-ship-inline-toggle">
                    <input type="checkbox" name="system.isSuperiorDurability" data-dtype="Boolean" {{#if system.isSuperiorDurability}}checked{{/if}} />
                    <span>{{localize 'ALTERNITY.Npc.SuperiorDurabilityLabel'}}</span>
                </label>
            </div>
        </section>

        {{!-- ═══ Damage tracks ═════════════════════════════════════════════ --}}
        <section class="{{alt}}-ship-table-section">
            <h3>{{localize 'ALTERNITY.Npc.DamageTracks'}}</h3>
            <div class="{{alt}}-resources">
                {{#each tracks as |t|}}
                <div class="{{../alt}}-resource-bar bar--{{t.key}}">
                    <div class="{{../alt}}-bar-label">
                        <span class="{{../alt}}-compartment-track-name">{{t.label}}</span>
                        <span class="{{../alt}}-bar-values">{{t.value}} / {{t.max}}</span>
                        <span class="{{../alt}}-damage-quick">
                            <button type="button" data-action="setNpcDamage" data-track="{{t.key}}" data-delta="-1">−</button>
                            <button type="button" data-action="setNpcDamage" data-track="{{t.key}}" data-delta="1">+</button>
                        </span>
                    </div>
                    <div class="{{../alt}}-bar-track"><div class="{{../alt}}-bar-fill" style="width: {{t.pct}}%"></div></div>
                </div>
                {{/each}}
            </div>
            <p class="{{alt}}-ai-note">{{localize 'ALTERNITY.Npc.DurabilityNote'}}</p>
        </section>

        {{!-- ═══ Wound level ═══════════════════════════════════════════════ --}}
        <section class="{{alt}}-ship-table-section">
            <h3>{{localize 'ALTERNITY.Npc.WoundLevel'}}</h3>
            <div class="{{alt}}-npc-wound-track">
                {{#each WOUND_LEVELS as |level|}}
                <button type="button" class="{{../alt}}-npc-wound-step {{#if (eq ../system.woundLevel level)}}is-current{{/if}}"
                        data-action="setWound" data-wound="{{level}}">
                    {{localize (concat 'ALTERNITY.' level)}}
                </button>
                {{/each}}
            </div>
            <div class="{{alt}}-stat-box">
                <label title="{{localize 'ALTERNITY.Npc.BleedRateHint'}}">{{localize 'ALTERNITY.Npc.BleedRate'}}</label>
                <input type="number" name="system.bleedRate" value="{{system.bleedRate}}" min="0" />
            </div>
        </section>

        {{!-- ═══ Movement ══════════════════════════════════════════════════ --}}
        <section class="{{alt}}-ship-table-section">
            <h3>
                {{localize 'ALTERNITY.Npc.Movement'}}
                {{#if movementSummary}}
                <span class="{{alt}}-robot-hardware-note">{{movementSummary}}</span>
                {{/if}}
            </h3>
            <div class="{{alt}}-stats-grid">
                {{#each movementKeys as |m|}}
                <div class="{{../alt}}-stat-box">
                    <label>{{m.label}}</label>
                    <input type="number" name="system.movement.{{m.key}}" value="{{m.value}}" min="0" />
                </div>
                {{/each}}
            </div>
        </section>

        {{!-- ═══ Attacks ═══════════════════════════════════════════════════ --}}
        <section class="{{alt}}-ship-table-section">
            <h3>
                {{localize 'ALTERNITY.Npc.Attacks'}}
                <button type="button" data-action="addNpcRow" data-array="attacks">+</button>
            </h3>
            <div class="{{alt}}-ship-table">
                {{#each attackRows as |row|}}
                <div class="{{../alt}}-ship-table-row">
                    <input type="text" name="system.attacks.{{row.index}}.name" value="{{row.name}}" placeholder="{{localize 'ALTERNITY.Name'}}" />
                    <input type="number" name="system.attacks.{{row.index}}.score" value="{{row.score}}" min="0" title="{{localize 'ALTERNITY.Npc.AttackScoreHint'}}" />
                    <span class="{{../alt}}-robot-resolved" title="{{localize 'ALTERNITY.Npc.AttackScoreRunHint'}}">{{row.scoreRun}}</span>
                    <input type="text" name="system.attacks.{{row.index}}.damageOrdinary" value="{{row.damageOrdinary}}" placeholder="d4+1s" title="{{localize 'ALTERNITY.DegreeOrdinary'}}" />
                    <input type="text" name="system.attacks.{{row.index}}.damageGood" value="{{row.damageGood}}" placeholder="d4w" title="{{localize 'ALTERNITY.DegreeGood'}}" />
                    <input type="text" name="system.attacks.{{row.index}}.damageAmazing" value="{{row.damageAmazing}}" placeholder="d6+2w" title="{{localize 'ALTERNITY.DegreeAmazing'}}" />
                    <select name="system.attacks.{{row.index}}.damageType">
                        {{#each ../damageTypeChoices as |choice|}}
                        <option value="{{choice}}" {{#if (eq row.damageType choice)}}selected{{/if}}>{{choice}}</option>
                        {{/each}}
                    </select>
                    <input type="text" name="system.attacks.{{row.index}}.range" value="{{row.range}}" placeholder="{{localize 'ALTERNITY.Npc.Range'}}" />
                    <button type="button" data-action="deleteNpcRow" data-array="attacks" data-index="{{row.index}}">✕</button>
                </div>
                {{else}}
                <p class="{{alt}}-empty-state">{{localize 'ALTERNITY.Npc.NoAttacks'}}</p>
                {{/each}}
            </div>
        </section>

        {{!-- ═══ Gamemaster notes ══════════════════════════════════════════ --}}
        <section class="{{alt}}-ship-table-section">
            <h3>{{localize 'ALTERNITY.Npc.Motivation'}}</h3>
            <input type="text" class="{{alt}}-robot-concept" name="system.motivation" value="{{system.motivation}}" placeholder="{{localize 'ALTERNITY.Npc.MotivationHint'}}" />
            <h3>{{localize 'ALTERNITY.Npc.Tactics'}}</h3>
            <textarea name="system.tactics" rows="3">{{system.tactics}}</textarea>
            <h3>{{localize 'ALTERNITY.Npc.Biography'}}</h3>
            <textarea name="system.biography" rows="3">{{system.biography}}</textarea>
        </section>

    </main>
</div>
