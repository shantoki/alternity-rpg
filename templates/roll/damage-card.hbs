{{!--
    Damage result card. Buttons use `data-alt-action` and are bound by hand in
    module_hooks/alt-mechanics.js — see roll-card.hbs for why.
--}}
<div class="alt-roll-card alt-damage-card">
    <header class="alt-roll-card-header">
        <span class="alt-roll-card-context">
            {{name}}
            {{#if gradeLabel}}<em class="alt-damage-grade">{{gradeLabel}}</em>{{/if}}
        </span>
        <span class="alt-roll-card-actor">{{code}}</span>
    </header>

    <div class="alt-roll-card-body">
        <div class="alt-damage-total track--{{category}}">
            <strong class="alt-damage-value">{{total}}</strong>
            <span class="alt-damage-category">{{categoryLabel}}</span>
            {{#if damageType}}<span class="alt-damage-type">{{damageType}}</span>{{/if}}
            {{#if firepower}}<span class="alt-damage-firepower">{{firepower}}</span>{{/if}}
        </div>

        <div class="alt-roll-rendered">
            {{{rollHtml}}}
        </div>

        {{#if degrade}}
        {{!-- Firepower inferior to the target's toughness costs a grade. --}}
        <p class="alt-roll-note">
            {{#if degrade.isNegated}}
                {{localize "ALTERNITY.Roll.DegradedToNothing"}}
            {{else}}
                {{localize "ALTERNITY.Roll.DegradedTo"}} {{degrade.finalGrade}}
            {{/if}}
        </p>
        {{/if}}

        {{!--
            Four ways to land the same rolled damage, because the recipient is not
            always on the canvas. The first two read the canvas and are deliberately
            *not* one button with a fallback: a Gamemaster who has both a target and a
            selection has to be able to say which of them this hit was for. The third
            reaches an actor with no token at all, and the fourth resolves against
            typed-in numbers and writes to nothing.
        --}}
        <div class="alt-roll-card-buttons">
            <button type="button" class="alt-card-btn" data-alt-action="applyDamage">
                {{localize "ALTERNITY.Roll.ApplyDamage"}}
            </button>
            <button type="button" class="alt-card-btn" data-alt-action="applyDamageSelected">
                {{localize "ALTERNITY.Roll.ApplyDamageSelected"}}
            </button>
            <button type="button" class="alt-card-btn" data-alt-action="applyDamageActor">
                {{localize "ALTERNITY.Roll.ApplyDamageActor"}}
            </button>
            <button type="button" class="alt-card-btn" data-alt-action="applyDamageManual">
                {{localize "ALTERNITY.Roll.ApplyDamageManual"}}
            </button>
        </div>
        <p class="alt-roll-note">{{localize "ALTERNITY.Roll.ApplyHint"}}</p>
    </div>
</div>
