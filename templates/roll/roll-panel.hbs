{{!--
    The inline pre-roll panel. Mounted into a sheet's `.alt-roll-mount`.

    Two things go in here and nothing else: what is about to be rolled, and the
    modifiers only a person at the table can decide. Everything the actor is
    already carrying (wounds, stances, worn armour) is listed read-only — it is
    collected by the roll service whether this panel shows it or not, and is
    printed so the step total is never a surprise.
--}}
<div class="{{alt}}-roll-panel" data-context="{{context}}">
    <header class="{{alt}}-roll-header">
        <span class="{{alt}}-roll-context-label">{{check.name}} — {{context}}</span>
        <button type="button" class="{{alt}}-roll-close" aria-label="{{localize 'ALTERNITY.Close'}}"
                title="{{localize 'ALTERNITY.Close'}}">✕</button>
    </header>

    <section class="{{alt}}-roll-checks">
        <div class="{{alt}}-roll-check-row">
            <span class="{{alt}}-roll-check-name">{{check.name}}</span>
            <span class="{{alt}}-roll-check-scores"
                  title="{{localize 'ALTERNITY.Roll.ScoresHint'}}">
                {{check.scores.ordinary}} / {{check.scores.good}} / {{check.scores.amazing}}
            </span>
            <span class="{{alt}}-roll-check-basestep"
                  title="{{localize 'ALTERNITY.Roll.BaseStepHint'}}">
                {{localize 'ALTERNITY.Roll.BaseStep'}} {{fmtMod check.baseStep}}
            </span>
        </div>
        {{#unless check.scores.ordinary}}
        {{!-- A score of 0 means the skill cannot be used untrained at all. --}}
        <p class="{{alt}}-ship-warning">{{localize 'ALTERNITY.Roll.CannotUseUntrained'}}</p>
        {{/unless}}
    </section>

    {{#if hasStanding}}
    <section class="{{alt}}-roll-standing">
        <span class="{{alt}}-roll-standing-label">{{localize 'ALTERNITY.Roll.AlreadyApplied'}}</span>
        <ul class="{{alt}}-roll-standing-list">
            {{#each standing}}
            <li title="{{reason}}">{{source}} {{fmtMod value}}</li>
            {{/each}}
        </ul>
    </section>
    {{/if}}

    <section class="{{alt}}-roll-steps">
        <label class="{{alt}}-roll-step-label" for="{{alt}}-roll-condition">
            {{localize 'ALTERNITY.Roll.Condition'}}
        </label>
        <select id="{{alt}}-roll-condition" class="{{alt}}-roll-condition-select"
                title="{{localize 'ALTERNITY.Roll.ConditionHint'}}">
            {{#each conditions}}
            <option value="{{key}}" {{#if isDefault}}selected{{/if}}>{{label}} ({{fmtMod steps}})</option>
            {{/each}}
        </select>

        {{#if hasRangeBands}}
        <label class="{{alt}}-roll-step-label" for="{{alt}}-roll-range">
            {{localize 'ALTERNITY.Roll.RangeBand'}}
        </label>
        <select id="{{alt}}-roll-range" class="{{alt}}-roll-range-select"
                data-range-class="{{check.rangeClass}}"
                title="{{localize 'ALTERNITY.Roll.RangeBandHint'}}">
            <option value="">{{localize 'ALTERNITY.Roll.NoRangeBand'}}</option>
            {{#each rangeBands}}
            <option value="{{band}}">{{label}} — {{distance}} m ({{fmtMod steps}})</option>
            {{/each}}
        </select>
        {{/if}}

        <label class="{{alt}}-roll-step-label" for="{{alt}}-roll-extra">
            {{localize 'ALTERNITY.Roll.ExtraSteps'}}
        </label>
        <input id="{{alt}}-roll-extra" class="{{alt}}-roll-step-input" type="number"
               value="0" step="1" min="-5" max="7"
               title="{{localize 'ALTERNITY.Roll.ExtraStepsHint'}}" />
    </section>

    <div class="{{alt}}-roll-actions">
        <button type="button" class="{{alt}}-roll-btn" data-action="roll">
            <span class="{{alt}}-roll-btn-icon">⬡</span>
            {{localize "ALTERNITY.Roll.Roll"}}
        </button>
        <label class="{{alt}}-roll-whisper-label" title="{{localize 'ALTERNITY.Roll.WhisperHint'}}">
            <input type="checkbox" class="{{alt}}-roll-whisper" />
            <span>{{localize 'ALTERNITY.Roll.Whisper'}}</span>
        </label>
    </div>

    {{#if hasDamage}}
    <p class="{{alt}}-roll-note">{{localize 'ALTERNITY.Roll.DamageOnCard'}}</p>
    {{/if}}

    <div class="{{alt}}-roll-outcome-slot" hidden></div>
</div>
